HE4P.32Y=Pe:PfICo"><field name="ASR">小明同学</field><field name="leibie">唤醒词</field><field name="huifu"></field><field name="id">9999</field><next><block type="asr_id" id="Mx@[n75s47cKn^[BO}2#" disabled="true"><field name="ASR">嗨佬麦</field><field name="leibie">唤醒词</field><field name="huifu">我在</field><field name="id">9998</field><next><block type="asr_id" id="vW/|IJ,74T/qGHvJ(/kj"><field name="ASR">同志们好</field><field name="leibie">命令词</field><field name="huifu">首长好</field><field name="id">9997</field><next><block type="asr_id" id="7G:Gl~w6J9NH7)*?FIz?"><field name="ASR">你好奔驰</field><field name="leibie">命令词</field><field name="huifu">主驾请将</field><field name="id">9996</field><next><block type="asr_id" id="bFC]nK6Y9}uK;]v]7J)["><field name="ASR">给我叫</field><field name="leibie">命令词</field><field name="huifu">我警告你，别给我在这哇哇叫</field><field name="id">9995</field><next><block type="asr_id" id="WGh,bSr^sIm$aEQgotZ^"><field name="ASR">挥手</field><field name="leibie">命令词</field><field name="huifu">你好呀</field><field name="id">0</field><next><block type="asr_id" id=".Xid,q-ElB,i-!WiaE6G"><field name="ASR">握手</field><field name="leibie">命令词</field><field name="huifu">很高兴认识你</field><field name="id">1</field><next><block type="asr_id" id="Z405aU1yly#P.8/D}L*i"><field name="ASR">双手挥动</field><field name="leibie">命令词</field><field name="huifu">好呀</field><field name="id">2</field><next><block type="asr_id" id="2[*Wa-:]=pl]CDRr8HEP"><field name="ASR">关闭声音</field><field name="leibie">命令词</field><field name="huifu">好的，那我不说话了</field><field name="id">3</field><next><block type="asr_id" id="!V%lj?Q_*BES(Yy7$)9a"><field name="ASR">退下吧</field><field name="leibie">命令词</field><field name="huifu">那我走啦，想我的话叫我小明同学</field><field name="id">4</field><next><block type="asr_id" id="OXV%kioSY(VAzT;BkwiY"><field name="ASR">复位</field><field name="leibie">命令词</field><field name="huifu"></field><field name="id">5</field><next><block type="asr_id" id="{i?+@|kU4!,eD).Bk38M"><field name="ASR">起身</field><field name="leibie">命令词</field><field name="huifu"></field><field name="id">6</field><next><block type="asr_id" id=")ssPkN_Y-Tl@Wy|lRyO5"><field name="ASR">做个自我介绍</field><field name="leibie">命令词</field><field name="huifu">大家好，我的名字是小明同学，是由添波动力公司设计的一款服务型机器人，有什么需求可以叫我哦</field><field name="id">7</field><next><block type="asr_id" id="(-pS+kKQ3.{@Od8@SSTW"><field name="ASR">奔驰能替我说话吗</field><field name="leibie">命令词</field><field name="huifu">当然，当你从奔驰车上下来的那一刻，就算你衣着普通，样貌平凡，在人群中，都是焦点，就算你生性内向，不言善语，在别人眼中也都是优点</field><field name="id">8</field><next><block type="asr_add_id" id="aheI4]odKehr[N#}24}n"><field name="NAME">奔驰</field><field name="id">9</field><next><block type="asr_id" id="3GM``JlZVxE(.go{J~Mm"><field name="ASR">起来吧</field><field name="leibie">命令词</field><field name="huifu"></field><field name="id">10</field><next><block type="asr_id" id="BXGEfU?.,)mRd`]k|Oc0"><field name="ASR">退下吧</field><field name="leibie">命令词</field><field name="huifu">好的，我先退下啦</field><field name="id">11</field><next><block type="asr_id" id="r*w,.?J^l7~vG.3#cgr#"><field name="ASR">平身</field><field name="leibie">命令词</field><field name="huifu">好的</field><field name="id">12</field><next><block type="asr_id" id="!UC]fYptEmn(Pv?;6elK"><field name="ASR">打开避障模式</field><field name="leibie">命令词</field><field name="huifu">避障模式已开启</field><field name="id">13</field><next><block type="asr_id" id="z(SOGX$Rq3iLC_)l_c[w"><field name="ASR">关闭避障模式</field><field name="leibie">命令词</field><field name="huifu">避障模式已关闭</field><field name="id">14</field><next><block type="asr_id" id="V7|8h#}?}ypLLF1.H%Uz"><field name="ASR">打开巡线模式</field><field name="leibie">命令词</field><field name="huifu">巡线模式已开启</field><field name="id">15</field><next><block type="asr_id" id="u9DBTres2z*+x3wlOXF|"><field name="ASR">关闭巡线模式</field><field name="leibie">命令词</field><field name="huifu">巡线模式已关闭</field><field name="id">16</field><next><block type="asr_id" id="@UU11b~{?QJa,=!qV.,7"><field name="ASR">打开语音控制</field><field name="leibie">命令词</field><field name="huif