# Face Tracking Example with Servo Control and LED Blinking
#
# This example shows off the built-in face detection feature of the OpenMV Cam.
# When a face is detected, the servos will track the face and the blue LED will blink.

import sensor
import time
import image
from pyb import millis
from math import pi, isnan
from pyb import Servo
from pyb import LED
from pyb import UART

class PID:
    _kp = _ki = _kd = _integrator = _imax = 0
    _last_error = _last_derivative = _last_t = 0
    _RC = 1/(2 * pi * 20)
    def __init__(self, p=0, i=0, d=0, imax=0):
        self._kp = float(p)
        self._ki = float(i)
        self._kd = float(d)
        self._imax = abs(imax)
        self._last_derivative = float('nan')

    def get_pid(self, error, scaler):
        tnow = millis()
        dt = tnow - self._last_t
        output = 0
        if self._last_t == 0 or dt > 1000:
            dt = 0
            self.reset_I()
        self._last_t = tnow
        delta_time = float(dt) / float(1000)
        output += error * self._kp
        if abs(self._kd) > 0 and dt > 0:
            if isnan(self._last_derivative):
                derivative = 0
                self._last_derivative = 0
            else:
                derivative = (error - self._last_error) / delta_time
            derivative = self._last_derivative + \
                                     ((delta_time / (self._RC + delta_time)) * \
                                        (derivative - self._last_derivative))
            self._last_error = error
            self._last_derivative = derivative
            output += self._kd * derivative
        output *= scaler
        if abs(self._ki) > 0 and dt > 0:
            self._integrator += (error * self._ki) * scaler * delta_time
            if self._integrator < -self._imax: self._integrator = -self._imax
            elif self._integrator > self._imax: self._integrator = self._imax
            output += self._integrator
        return output
    def reset_I(self):
        self._integrator = 0
        self._last_derivative = float('nan')

# 初始化设置
def init_setup():
    global pan_servo, tilt_servo, pan_pid, tilt_pid, sensor, clock, face_cascade, led, uart
    
    # 初始化串口1
    uart = UART(1, 9600)  # 使用P4(TX)和P5(RX)引脚，波特率9600
    uart.init(9600, bits=8, parity=None, stop=1)  # 初始化串口
    
    # 初始化蓝色LED
    led = LED(3)  # 蓝色LED
    led.off()     # 初始状态关闭

    # 加载人脸识别Haar Cascade
    face_cascade = image.HaarCascade("/rom/haarcascade_frontalface.cascade", stages=25)
    print(face_cascade)

    pan_servo = Servo(1)                         # 实例化云台靠下的舵机
    tilt_servo = Servo(2)                        # 实例化云台靠上的舵机

    pan_servo.calibration(500,2500,1500)         # 设置舵机脉冲范围为500-2500，中心位置为1500
    tilt_servo.calibration(500,2500,1500)        # 设置舵机脉冲范围为500-2500，中心位置为1500

    # 调整PID参数以适应人脸跟踪
    pan_pid = PID(p=0.08, i=0, d=0.003, imax=90)    # 水平方向PID
    tilt_pid = PID(p=0.08, i=0, d=0.006, imax=90)   # 垂直方向PID

    sensor.reset()                               # 初始化感光元件
    sensor.set_contrast(3)                       # 设置对比度
    sensor.set_gainceiling(16)                   # 设置增益上限
    sensor.set_pixformat(sensor.GRAYSCALE)       # 人脸检测使用灰度图像
    sensor.set_framesize(sensor.HQVGA)           # 图像大小设置为HQVGA，即240x160
    sensor.skip_frames(10)                       # 跳过10帧，使以上设置生效
    sensor.set_auto_whitebal(False)              # 关闭白平衡
    clock = time.clock()                         # 创建时钟对象
    
    # 开机时舵机复位到中间位置
    middle()
    print("System initialized. Send '0' to start tracking, '1' to stop.")

# 舵机回归中位
def middle():
    pan_servo.angle(0)                     # 舵机转到0度位置
    tilt_servo.angle(0)                    # 舵机转到0度位置
    time.sleep(1)                          # 延时1秒

# 查找识别到的人脸区域中最大区域的函数
def find_max(faces):
    max_size = 0
    for face in faces:
        # 人脸检测返回的是矩形 (x, y, w, h)
        if face[2] * face[3] > max_size:
            max_face = face
            max_size = face[2] * face[3]
    return max_face

# 主函数
def main():
    # LED闪烁控制变量
    last_led_toggle = 0
    led_state = False
    
    # 跟踪功能状态标志
    tracking_enabled = False
    
    # 舵机复位状态标志
    servo_reset = False

    while True:
        clock.tick()                             # 更新FPS帧率时钟
        
        # 检查串口是否有数据
        if uart.any():
            data = uart.read(1)  # 读取一个字节
            if data == b'0':     # 接收到'0'，开启跟踪
                tracking_enabled = True
                servo_reset = False  # 重置复位标志
                print("Tracking enabled")
            elif data == b'1':   # 接收到'1'，关闭跟踪
                tracking_enabled = False
                print("Tracking disabled")
        
        img = sensor.snapshot()                  # 拍一张照片并返回图像

        # 检测人脸
        faces = img.find_features(face_cascade, threshold=0.75, scale_factor=1.25)

        # 控制LED闪烁 - 只有在跟踪启用且检测到人脸时才闪烁
        if tracking_enabled and faces:
            current_time = time.ticks_ms()
            if time.ticks_diff(current_time, last_led_toggle) > 500:  # 500ms间隔闪烁
                led_state = not led_state
                if led_state:
                    led.on()
                else:
                    led.off()
                last_led_toggle = current_time
        else:
            # 没有人脸或跟踪未启用时关闭LED
            led.off()
            led_state = False

        # 如果跟踪功能启用且检测到人脸，则进行跟踪
        if tracking_enabled and faces:
            max_face = find_max(faces)           # 找到最大的人脸区域

            # 计算人脸中心点与图像中心的误差
            # 人脸检测返回的是矩形 (x, y, w, h)
            face_center_x = max_face[0] + max_face[2] // 2
            face_center_y = max_face[1] + max_face[3] // 2

            pan_error = face_center_x - img.width() // 2
            tilt_error = face_center_y - img.height() // 2

            # 绘制人脸矩形和中心十字
            img.draw_rectangle(max_face)
            img.draw_cross(face_center_x, face_center_y)

            # 计算PID输出
            pan_output = pan_pid.get_pid(pan_error, 1) / 2
            tilt_output = tilt_pid.get_pid(tilt_error, 1) / 2

            # 控制舵机转动
            pan_servo.angle(pan_servo.angle() - pan_output)
            tilt_servo.angle(tilt_servo.angle() + tilt_output)

            # 异常判断，定义舵机极限位置
            if pan_servo.angle() > 90:
                pan_servo.angle(90)
            if pan_servo.angle() < -90:
                pan_servo.angle(-90)
            if tilt_servo.angle() > 45:
                tilt_servo.angle(45)
            if tilt_servo.angle() < -60:
                tilt_servo.angle(-60)
        else:
            # 如果没有检测到人脸或跟踪未启用，重置PID积分项以防止积分饱和
            pan_pid.reset_I()
            tilt_pid.reset_I()
            
            # 如果跟踪功能被禁用且舵机尚未复位，则复位舵机
            if not tracking_enabled and not servo_reset:
                middle()
                servo_reset = True  # 设置复位标志，避免重复复位

        # 打印FPS
        print(clock.fps())

# 程序入口
if __name__ == '__main__':
    init_setup()    # 执行初始化函数
    try:
        main()      # 执行主函数
    finally:
        middle()    # 程序结束时使云台舵机复位
        led.off()   # 确保程序结束时LED关闭
        