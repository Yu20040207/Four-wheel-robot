# openmv_emqx_stream_fixed_socket_v5.py
import sensor
import network
import time
import socket
import struct
import ujson
import gc
import machine
from pyb import LED

# 配置区域
SSID = "MTCPC"
KEY = "mt12345mt"

# EMQX服务器配置
EMQX_BROKER = "192.168.13.225"
EMQX_PORT = 1883
EMQX_USERNAME = "sy"
EMQX_PASSWORD = "123"

# MQTT主题
VIDEO_TOPIC = "openmv/video/stream"
STATUS_TOPIC = "openmv/status"
RECOGNITION_RESULT_TOPIC = "openmv_recognition_result"
RECOGNITION_ACK_TOPIC = "openmv/recognition_ack"

# 视频流配置
FRAME_SIZE = sensor.QQVGA  # 160x120
FRAME_QUALITY = 30
TARGET_FPS = 5

# 全局变量
mqtt_socket = None
frame_count = 0
last_recognition_time = 0
received_messages = []
message_buffer = bytearray()
# 使用固定的客户端ID
CLIENT_ID = "openmv_camera_001"

# LED状态
LED_NORMAL = 0      # 正常运行 - 绿色灯持续闪烁
LED_ERROR = 1       # 出现问题 - 红色灯持续闪烁  
LED_RECOGNITION = 2 # 收到识别 - 蓝色灯闪烁一次
current_led_state = LED_NORMAL
led_blink_state = False
last_led_change = 0
led_blink_interval = 500  # 毫秒

def init_camera():
    """初始化摄像头"""
    sensor.reset()
    sensor.set_pixformat(sensor.RGB565)
    sensor.set_framesize(FRAME_SIZE)
    sensor.skip_frames(20)
    sensor.set_auto_whitebal(False)
    sensor.set_auto_gain(False)
    sensor.set_auto_exposure(False, exposure_us=20000)
    print("摄像头初始化完成 - 分辨率: {}x{}".format(sensor.width(), sensor.height()))

def init_led():
    """初始化LED"""
    # OpenMV板载RGB LED
    # 红色LED: 引脚1
    # 绿色LED: 引脚2  
    # 蓝色LED: 引脚3
    global red_led, green_led, blue_led
    red_led = LED(1)   # 红色
    green_led = LED(2) # 绿色
    blue_led = LED(3)  # 蓝色
    
    # 初始关闭所有LED
    red_led.off()
    green_led.off()
    blue_led.off()
    print("LED初始化完成")

def update_led():
    """更新LED状态"""
    global current_led_state, led_blink_state, last_led_change
    
    current_time = time.ticks_ms()
    
    # 检查是否需要切换LED状态
    if time.ticks_diff(current_time, last_led_change) > led_blink_interval:
        led_blink_state = not led_blink_state
        last_led_change = current_time
        
        # 根据当前状态设置LED
        if current_led_state == LED_NORMAL:
            # 正常运行 - 绿色灯闪烁
            if led_blink_state:
                green_led.on()
                red_led.off()
                blue_led.off()
            else:
                green_led.off()
                
        elif current_led_state == LED_ERROR:
            # 错误状态 - 红色灯闪烁
            if led_blink_state:
                red_led.on()
                green_led.off()
                blue_led.off()
            else:
                red_led.off()
                
        elif current_led_state == LED_RECOGNITION:
            # 识别状态 - 蓝色灯亮一次后恢复之前状态
            blue_led.on()
            green_led.off()
            red_led.off()
            # 100ms后关闭蓝灯并恢复之前状态
            if time.ticks_diff(current_time, last_led_change) > 100:
                blue_led.off()
                current_led_state = LED_NORMAL  # 恢复为正常状态

def set_led_state(state):
    """设置LED状态"""
    global current_led_state, last_led_change
    current_led_state = state
    last_led_change = time.ticks_ms()  # 重置计时器
    
    # 立即更新LED显示
    if state == LED_NORMAL:
        green_led.on()
        red_led.off()
        blue_led.off()
    elif state == LED_ERROR:
        red_led.on()
        green_led.off()
        blue_led.off()
    elif state == LED_RECOGNITION:
        blue_led.on()
        green_led.off()
        red_led.off()

def connect_wifi():
    """连接WiFi"""
    wlan = network.WLAN(network.STA_IF)
    wlan.active(True)

    print("连接WiFi: {}...".format(SSID))

    if wlan.isconnected():
        wlan.disconnect()
        time.sleep(1)

    wlan.connect(SSID, KEY)

    timeout = 30
    while not wlan.isconnected() and timeout > 0:
        time.sleep_ms(500)
        timeout -= 1
        print(".", end="")

    if wlan.isconnected():
        print("\nWiFi连接成功!")
        print("IP地址:", wlan.ifconfig()[0])
        set_led_state(LED_NORMAL)
        return True
    else:
        print("\nWiFi连接失败!")
        set_led_state(LED_ERROR)
        return False

def subscribe_topic(sock, topic):
    """订阅主题"""
    try:
        packet_id = 1
        subscribe_payload = bytearray()
        subscribe_payload.extend(struct.pack(">H", packet_id))
        subscribe_payload.extend(struct.pack(">H", len(topic)))
        subscribe_payload.extend(topic.encode())
        subscribe_payload.append(0)  # QoS 0
        
        remaining_len = len(subscribe_payload)
        subscribe_packet = bytearray([0x82, remaining_len]) + subscribe_payload
        sock.send(subscribe_packet)
        
        # 读取SUBACK响应
        suback = sock.recv(5)
        print(f"SUBACK响应: {suback.hex()}")
        print(f"✅ 成功订阅主题: {topic}")
        return True
        
    except Exception as e:
        print(f"订阅主题失败: {e}")
        set_led_state(LED_ERROR)
        return False

def connect_mqtt_socket():
    """使用原始Socket连接MQTT服务器"""
    global mqtt_socket
    
    try:
        print(f"🔗 连接MQTT Socket: {EMQX_BROKER}:{EMQX_PORT}")
        
        # 创建socket连接
        addr = socket.getaddrinfo(EMQX_BROKER, EMQX_PORT)[0][-1]
        sock = socket.socket()
        sock.connect(addr)
        print("✅ Socket连接成功")
        
        # 构建MQTT CONNECT报文
        protocol_name = "MQTT"
        protocol_level = 4
        connect_flags = 0xC2  # Clean Session, Username, Password
        keepalive = 60
        
        variable_header = bytearray()
        variable_header.extend(struct.pack(">H", len(protocol_name)))
        variable_header.extend(protocol_name.encode())
        variable_header.append(protocol_level)
        variable_header.append(connect_flags)
        variable_header.extend(struct.pack(">H", keepalive))
        
        payload = bytearray()
        payload.extend(struct.pack(">H", len(CLIENT_ID)))
        payload.extend(CLIENT_ID.encode())
        payload.extend(struct.pack(">H", len(EMQX_USERNAME)))
        payload.extend(EMQX_USERNAME.encode())
        payload.extend(struct.pack(">H", len(EMQX_PASSWORD)))
        payload.extend(EMQX_PASSWORD.encode())
        
        remaining_length = len(variable_header) + len(payload)
        fixed_header = bytearray([0x10, remaining_length])
        
        connect_packet = fixed_header + variable_header + payload
        sock.send(connect_packet)
        print("已发送CONNECT报文")
        
        # 读取CONNACK响应
        connack = sock.recv(4)
        print("CONNACK响应:", connack.hex())
        
        if connack[0] == 0x20 and connack[3] == 0x00:
            print("✅ MQTT连接成功")
            
            # 订阅识别结果主题
            subscribe_topic(sock, RECOGNITION_RESULT_TOPIC)
            
            mqtt_socket = sock
            set_led_state(LED_NORMAL)
            return True
        else:
            print("❌ MQTT连接失败")
            sock.close()
            set_led_state(LED_ERROR)
            return False
            
    except Exception as e:
        print(f"❌ MQTT Socket连接失败: {e}")
        set_led_state(LED_ERROR)
        return False

def encode_remaining_length(length):
    """编码MQTT剩余长度字段"""
    encoded = bytearray()
    while True:
        digit = length % 128
        length //= 128
        if length > 0:
            digit |= 0x80
        encoded.append(digit)
        if length == 0:
            break
    return encoded

def publish_message_safe(topic, message):
    """安全地发布消息到MQTT主题 - 修复版本"""
    global mqtt_socket
    
    if not mqtt_socket:
        print("❌ MQTT Socket未连接")
        set_led_state(LED_ERROR)
        return False
        
    try:
        # 确保消息是字节类型
        if isinstance(message, str):
            message_bytes = message.encode('utf-8')
        else:
            message_bytes = message
        
        # 检查消息长度
        if len(message_bytes) > 65535:
            print(f"❌ 消息过长: {len(message_bytes)} 字节")
            set_led_state(LED_ERROR)
            return False
        
        # 固定头部: PUBLISH (0x30), QoS 0
        fixed_header = bytearray([0x30])
        
        # 可变头部: 主题长度 + 主题
        variable_header = bytearray()
        topic_bytes = topic.encode('utf-8')
        variable_header.extend(struct.pack(">H", len(topic_bytes)))
        variable_header.extend(topic_bytes)
        
        # 载荷: 消息内容
        payload = message_bytes
        
        # 计算剩余长度
        remaining_length = len(variable_header) + len(payload)
        
        # 编码剩余长度
        encoded_remaining = encode_remaining_length(remaining_length)
        fixed_header.extend(encoded_remaining)
        
        # 构建完整报文
        publish_packet = fixed_header + variable_header + payload
        
        # 发送报文
        bytes_sent = mqtt_socket.send(publish_packet)
        if bytes_sent == len(publish_packet):
            set_led_state(LED_NORMAL)  # 发送成功，恢复正常状态
            return True
        else:
            print(f"❌ 发送不完整: {bytes_sent}/{len(publish_packet)} 字节")
            set_led_state(LED_ERROR)
            return False
        
    except Exception as e:
        print(f"发布消息失败: {e}")
        set_led_state(LED_ERROR)
        return False

def parse_mqtt_publish_safe(data):
    """安全地解析MQTT PUBLISH报文"""
    try:
        if len(data) < 2:
            return None, None
            
        # 检查是否是PUBLISH报文
        if (data[0] & 0xF0) != 0x30:
            return None, None
            
        # 解析剩余长度（变长编码）
        multiplier = 1
        value = 0
        pos = 1
        
        while True:
            if pos >= len(data):
                return None, None
            encoded_byte = data[pos]
            value += (encoded_byte & 127) * multiplier
            multiplier *= 128
            pos += 1
            if (encoded_byte & 128) == 0:
                break
            if multiplier > 128 * 128 * 128:
                return None, None  # 剩余长度过长
        
        remaining_length = value
        total_length = pos + remaining_length
        
        # 检查数据长度是否足够
        if len(data) < total_length:
            return None, None
            
        # 解析主题长度
        if len(data) < pos + 2:
            return None, None
        topic_length = struct.unpack(">H", data[pos:pos+2])[0]
        
        # 检查主题长度是否合理
        if topic_length > 1000:  # 假设主题长度不会超过1000
            return None, None
            
        # 检查数据长度是否足够包含主题
        if len(data) < pos + 2 + topic_length:
            return None, None
            
        # 提取主题
        topic = data[pos+2:pos+2+topic_length]
        try:
            topic_str = topic.decode('utf-8')
        except:
            return None, None
        
        # 提取消息内容
        message_start = pos + 2 + topic_length
        if len(data) < message_start:
            return topic_str, None
            
        message = data[message_start:total_length]
        
        return topic_str, message
        
    except Exception as e:
        print(f"解析MQTT报文错误: {e}")
        return None, None

def check_and_process_messages():
    """检查并处理接收到的MQTT消息"""
    global mqtt_socket, message_buffer, received_messages, last_recognition_time
    
    if not mqtt_socket:
        return
        
    try:
        # 非阻塞接收数据
        mqtt_socket.setblocking(False)
        try:
            chunk = mqtt_socket.recv(1024)
            if chunk:
                message_buffer.extend(chunk)
        except OSError:
            # 没有数据可用，正常情况
            pass
        
        # 处理缓冲区中的数据
        while len(message_buffer) >= 2:
            packet_type = message_buffer[0] & 0xF0
            
            if packet_type == 0x30:  # PUBLISH报文
                # 尝试解析报文
                topic, message = parse_mqtt_publish_safe(message_buffer)
                
                if topic and message:
                    # 计算已处理的字节数
                    multiplier = 1
                    value = 0
                    pos = 1
                    
                    while pos < len(message_buffer):
                        encoded_byte = message_buffer[pos]
                        value += (encoded_byte & 127) * multiplier
                        multiplier *= 128
                        pos += 1
                        if (encoded_byte & 128) == 0:
                            break
                    
                    total_length = pos + value
                    
                    # 移除已处理的数据
                    if len(message_buffer) >= total_length:
                        message_buffer = message_buffer[total_length:]
                        
                        # 将消息添加到处理队列
                        try:
                            message_str = message.decode('utf-8')
                            received_messages.append((topic, message_str))
                            print(f"📨 收到消息 - 主题: {topic}, 长度: {len(message)}字节")
                            
                            # 如果是识别结果，设置蓝色LED
                            if topic == RECOGNITION_RESULT_TOPIC:
                                set_led_state(LED_RECOGNITION)
                                
                        except Exception as e:
                            print(f"解码消息失败: {e}")
                    else:
                        # 报文不完整，等待更多数据
                        break
                else:
                    # 解析失败，跳过第一个字节继续尝试
                    message_buffer = message_buffer[1:]
            else:
                # 其他类型报文，跳过第一个字节
                message_buffer = message_buffer[1:]
                    
        # 处理接收到的消息
        process_received_messages()
        
    except Exception as e:
        print(f"检查消息时出错: {e}")
        set_led_state(LED_ERROR)

def process_received_messages():
    """处理已接收的消息"""
    global received_messages, last_recognition_time
    
    if not received_messages:
        return

    for topic, msg_str in received_messages:
        try:
            print(f"处理消息 - 主题: {topic}, 内容: {msg_str}")

            data = ujson.loads(msg_str)

            if topic == RECOGNITION_RESULT_TOPIC:
                recognized_names = data.get("recognized_names", [])
                count = data.get("count", 0)
                timestamp = data.get("timestamp", 0)
                confidence_scores = data.get("confidence_scores", [])

                if count > 0:
                    print("\n" + "="*50)
                    print("🎯 人脸识别结果:")
                    print("  识别到 {} 个人:".format(count))
                    for i, name in enumerate(recognized_names):
                        confidence_text = ""
                        if i < len(confidence_scores):
                            confidence_text = " (置信度: {}%)".format(confidence_scores[i])
                        print("  👤 {}: {}{}".format(i+1, name, confidence_text))
                    print("  时间戳:", timestamp)
                    print("="*50)

                    # 根据识别结果执行相应操作
                    for name in recognized_names:
                        print("✅ 欢迎 {}!".format(name))

                    # 发送确认消息回服务器
                    ack_message = {
                        "status": "received",
                        "recognized_names": recognized_names,
                        "count": count,
                        "client_timestamp": time.ticks_ms(),
                        "server_timestamp": timestamp
                    }
                    if publish_message_safe(RECOGNITION_ACK_TOPIC, ujson.dumps(ack_message)):
                        print("📨 已发送确认消息到服务器")
                    else:
                        print("❌ 发送确认消息失败")

                    last_recognition_time = time.ticks_ms()
                else:
                    print("\n❌ 未识别到任何人脸")

        except Exception as e:
            print("处理消息失败:", e)
            print("原始消息:", msg_str)
            set_led_state(LED_ERROR)

    # 清空消息队列
    received_messages = []

def send_frame():
    """发送一帧图像"""
    global frame_count

    try:
        # 捕获图像
        img = sensor.snapshot()

        # 压缩为JPEG
        jpeg_data = img.compress(quality=FRAME_QUALITY)
        if not isinstance(jpeg_data, bytes):
            jpeg_data = bytes(jpeg_data)

        frame_size = len(jpeg_data)

        # 构建消息 - 包含实际的图像数据
        message = {
            "frame_id": frame_count,
            "timestamp": time.ticks_ms(),
            "data": jpeg_data.hex()  # 图像数据
        }

        # 发布消息
        if publish_message_safe(VIDEO_TOPIC, ujson.dumps(message)):
            frame_count += 1

        if frame_count % 10 == 0:
            print("📹 已发送 {} 帧, 大小: {} 字节".format(frame_count, frame_size))

        return True

    except Exception as e:
        print("发送帧失败:", e)
        set_led_state(LED_ERROR)
        return False

def send_status():
    """发送状态信息"""
    global frame_count, last_recognition_time
    
    status_msg = {
        "frames_sent": frame_count,
        "memory_free": gc.mem_free(),
        "status": "streaming",
        "last_recognition_time": last_recognition_time,
        "current_time": time.ticks_ms(),
        "client_id": CLIENT_ID
    }
    
    if publish_message_safe(STATUS_TOPIC, ujson.dumps(status_msg)):
        # 显示状态
        current_time = time.ticks_ms()
        if last_recognition_time > 0 and time.ticks_diff(current_time, last_recognition_time) < 30000:
            time_diff = time.ticks_diff(current_time, last_recognition_time) // 1000
            print("📊 状态: {}秒前识别到人脸".format(time_diff))
        else:
            print("📊 状态: 运行中... 等待识别结果")
        return True
    else:
        print("❌ 发送状态失败")
        return False

def test_publish():
    """测试发布功能"""
    print("测试发布功能...")
    
    # 测试发送简单消息
    test_msg = {
        "test": "hello",
        "timestamp": time.ticks_ms(),
        "client_id": CLIENT_ID
    }
    
    if publish_message_safe("openmv/test", ujson.dumps(test_msg)):
        print("✅ 测试消息发送成功")
        return True
    else:
        print("❌ 测试消息发送失败")
        return False

def main():
    """主函数"""
    print("=== OpenMV EMQX视频流 (Socket版 v5 - 带LED指示) ===")
    print(f"使用固定客户端ID: {CLIENT_ID}")

    # 初始化摄像头
    init_camera()
    
    # 初始化LED
    init_led()
    
    # 初始LED状态为正常
    set_led_state(LED_NORMAL)

    # 连接WiFi
    if not connect_wifi():
        return

    # 连接MQTT (使用Socket)
    if not connect_mqtt_socket():
        return

    # 测试发布功能
    print("\n测试发布功能...")
    if not test_publish():
        print("❌ 发布功能测试失败，程序退出")
        set_led_state(LED_ERROR)
        return

    print("\n🚀 系统就绪! 开始视频流传输...")
    print("分辨率: {}x{}, FPS: {}, 质量: {}%".format(
        sensor.width(), sensor.height(), TARGET_FPS, FRAME_QUALITY))
    print("LED指示:")
    print("  🟢 绿色闪烁 - 正常运行")
    print("  🔴 红色闪烁 - 出现问题")
    print("  🔵 蓝色闪烁 - 收到人脸识别")

    last_status_time = time.ticks_ms()

    while True:
        current_time = time.ticks_ms()

        # 更新LED状态
        update_led()

        # 检查并处理MQTT消息
        check_and_process_messages()

        # 发送视频帧
        send_frame()

        # 定期发送状态
        if time.ticks_diff(current_time, last_status_time) > 10000:  # 10秒
            send_status()
            gc.collect()
            last_status_time = current_time

        # 控制帧率
        time.sleep_ms(int(1000 / TARGET_FPS))

if __name__ == "__main__":
    try:
        main()
    except Exception as e:
        print("程序错误:", e)
        import sys
        sys.print_exception(e)
        # 错误时设置红色LED
        set_led_state(LED_ERROR)
    finally:
        if mqtt_socket:
            try:
                mqtt_socket.close()
                print("已关闭MQTT Socket连接")
            except:
                pass
        # 程序结束时关闭所有LED
        red_led.off()
        green_led.off()
        blue_led.off()
        print("程序结束")
        