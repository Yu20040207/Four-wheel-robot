# openmv_emqx_stream_simple.py
import sensor
import network
import time
from mqtt import MQTTClient
import ujson
import gc

# 配置区域
SSID = "MTCPC"
KEY = "mt12345mt"

# EMQX服务器配置
EMQX_BROKER = "192.168.13.225"
EMQX_PORT = 1883
EMQX_USERNAME = "sy"
EMQX_PASSWORD = "123"

# MQTT主题
VIDEO_TOPIC = "openmv/video/stream"
STATUS_TOPIC = "openmv/status"
RECOGNITION_RESULT_TOPIC = "openmv/recognition_result"

# 视频流配置
FRAME_SIZE = sensor.QQVGA  # 降低分辨率到 160x120
FRAME_QUALITY = 50         # 降低质量
TARGET_FPS = 10            # 降低帧率

# 全局变量
mqtt_client = None
frame_count = 0
last_recognition_time = 0

def init_camera():
    """初始化摄像头"""
    sensor.reset()
    sensor.set_pixformat(sensor.RGB565)
    sensor.set_framesize(FRAME_SIZE)
    sensor.skip_frames(20)
    sensor.set_auto_whitebal(False)
    sensor.set_auto_gain(False)
    sensor.set_auto_exposure(False, exposure_us=20000)  # 增加曝光时间
    print("摄像头初始化完成 - 分辨率: {}x{}".format(sensor.width(), sensor.height()))

def connect_wifi():
    """连接WiFi"""
    wlan = network.WLAN(network.STA_IF)
    wlan.active(True)
    
    if wlan.isconnected():
        print("已连接到WiFi")
        print("IP地址:", wlan.ifconfig()[0])
        return True

    print("连接WiFi: {}...".format(SSID))
    wlan.connect(SSID, KEY)

    for i in range(20):  # 10秒超时
        if wlan.isconnected():
            print("\nWiFi连接成功!")
            print("IP地址:", wlan.ifconfig()[0])
            return True
        time.sleep_ms(500)
        print(".", end="")
    
    print("\nWiFi连接失败!")
    return False

def recognition_callback(topic, msg):
    """处理识别结果回调函数"""
    global last_recognition_time
    
    try:
        data = ujson.loads(msg)
        recognized_names = data.get("recognized_names", [])
        count = data.get("count", 0)
        
        if count > 0:
            print("\n" + "="*30)
            print("人脸识别结果:")
            for i, name in enumerate(recognized_names):
                print("  {}: {}".format(i+1, name))
            print("="*30)
            
            # 根据识别结果执行操作
            for name in recognized_names:
                print("欢迎 {}!".format(name))
        else:
            print("未识别到人脸")
            
        last_recognition_time = time.ticks_ms()
        
    except Exception as e:
        print("解析识别结果失败:", e)

def create_mqtt_client():
    """创建MQTT客户端"""
    try:
        client_id = "openmv_{}".format(time.ticks_ms())
        client = MQTTClient(
            client_id,
            EMQX_BROKER,
            port=EMQX_PORT,
            user=EMQX_USERNAME,
            password=EMQX_PASSWORD,
            keepalive=60  # 增加keepalive时间
        )
        
        client.set_callback(recognition_callback)
        return client
    except Exception as e:
        print("创建MQTT客户端失败:", e)
        return None

def connect_mqtt():
    """连接MQTT服务器"""
    global mqtt_client
    
    try:
        if mqtt_client:
            try:
                mqtt_client.disconnect()
            except:
                pass
        
        mqtt_client = create_mqtt_client()
        if not mqtt_client:
            return False
            
        mqtt_client.connect()
        mqtt_client.subscribe(RECOGNITION_RESULT_TOPIC)
        print("MQTT连接成功! 已订阅主题:", RECOGNITION_RESULT_TOPIC)
        return True
        
    except Exception as e:
        print("MQTT连接失败:", e)
        mqtt_client = None
        return False

def safe_check_msg():
    """安全地检查MQTT消息"""
    global mqtt_client
    
    if not mqtt_client:
        return False
        
    try:
        mqtt_client.check_msg()
        return True
    except Exception as e:
        print("检查消息失败:", e)
        mqtt_client = None
        return False

def safe_publish(topic, message):
    """安全地发布消息"""
    global mqtt_client
    
    if not mqtt_client:
        return False
        
    try:
        mqtt_client.publish(topic, message)
        return True
    except Exception as e:
        print("发布消息失败:", e)
        mqtt_client = None
        return False

def send_frame():
    """发送一帧图像"""
    global frame_count
    
    try:
        # 捕获图像
        img = sensor.snapshot()
        
        # 压缩为JPEG
        jpeg_data = img.compress(quality=FRAME_QUALITY)
        if not isinstance(jpeg_data, bytes):
            jpeg_data = bytes(jpeg_data)
        
        # 构建消息
        message = {
            "frame_id": frame_count,
            "timestamp": time.ticks_ms(),
            "size": len(jpeg_data),
            "resolution": "{}x{}".format(sensor.width(), sensor.height()),
            "data": jpeg_data.hex()
        }
        
        # 发布消息
        if safe_publish(VIDEO_TOPIC, ujson.dumps(message)):
            frame_count += 1
            if frame_count % 20 == 0:
                print("已发送 {} 帧".format(frame_count))
            return True
            
    except Exception as e:
        print("发送帧失败:", e)
    
    return False

def main():
    """主函数"""
    print("=== OpenMV 视频流 ===")
    
    # 初始化摄像头
    init_camera()
    
    # 连接WiFi
    if not connect_wifi():
        return
    
    # 连接MQTT
    if not connect_mqtt():
        return
    
    print("开始视频流...")
    print("分辨率: {}x{}, FPS: {}, 质量: {}%".format(
        sensor.width(), sensor.height(), TARGET_FPS, FRAME_QUALITY))
    
    last_status_time = time.ticks_ms()
    last_reconnect_attempt = time.ticks_ms()
    frames_since_last_check = 0
    
    while True:
        current_time = time.ticks_ms()
        
        # 每5帧检查一次MQTT消息（减少频率）
        if frames_since_last_check >= 5:
            safe_check_msg()
            frames_since_last_check = 0
        
        # 发送视频帧
        frame_sent = send_frame()
        if frame_sent:
            frames_since_last_check += 1
        
        # 定期发送状态（减少频率）
        if time.ticks_diff(current_time, last_status_time) > 30000:  # 30秒
            status_msg = {
                "frames_sent": frame_count,
                "memory_free": gc.mem_free(),
                "status": "streaming"
            }
            safe_publish(STATUS_TOPIC, ujson.dumps(status_msg))
            gc.collect()
            last_status_time = current_time
        
        # 定期尝试重新连接（如果断开）
        if not mqtt_client and time.ticks_diff(current_time, last_reconnect_attempt) > 10000:
            print("尝试重新连接MQTT...")
            if connect_mqtt():
                print("重新连接成功")
            last_reconnect_attempt = current_time
        
        # 控制帧率
        time.sleep_ms(int(1000 / TARGET_FPS))

if __name__ == "__main__":
    try:
        main()
    except Exception as e:
        print("程序错误:", e)
    finally:
        if mqtt_client:
            try:
                mqtt_client.disconnect()
            except:
                pass
        print("程序结束")
        