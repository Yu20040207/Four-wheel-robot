# 初始化状态
camera_initialized = False
servos_initialized = False

def init_camera(mode=CAMERA_MODE_COLOR):
    """初始化摄像头 - 优化版本"""
    global current_camera_mode, camera_initialized
    try:
        # 只在第一次初始化时reset
        if not camera_initialized:
            sensor.reset()
            camera_initialized = True

        if mode == CAMERA_MODE_COLOR:
            sensor.set_pixformat(sensor.RGB565)
            mode_str = "彩色"
        else:
            sensor.set_pixformat(sensor.GRAYSCALE)
            mode_str = "灰度"

        sensor.set_framesize(FRAME_SIZE)
        sensor.skip_frames(10)  # 减少跳帧数
        sensor.set_auto_whitebal(False)
        sensor.set_auto_gain(False)
        sensor.set_auto_exposure(False, exposure_us=20000)

        current_camera_mode = mode
        print("摄像头初始化完成 - {}模式, 分辨率: {}x{}".format(mode_str, sensor.width(), sensor.height()))
        return True
    except Exception as e:
        print(f"❌ 摄像头初始化失败: {e}")
        return False

def switch_camera_mode(mode):
    """切换摄像头模式 - 优化版本"""
    global current_camera_mode
    if current_camera_mode == mode:
        return True

    try:
        if mode == CAMERA_MODE_COLOR:
            sensor.set_pixformat(sensor.RGB565)
            mode_str = "彩色"
        else:
            sensor.set_pixformat(sensor.GRAYSCALE)
            mode_str = "灰度"

        sensor.skip_frames(3)  # 减少跳帧
        current_camera_mode = mode
        print(f"✅ 摄像头切换到{mode_str}模式")
        return True
    except Exception as e:
        print(f"❌ 摄像头模式切换失败: {e}")
        return False

def init_servos():
    """初始化舵机 - 优化版本"""
    global pan_servo, tilt_servo, pan_pid, tilt_pid, servos_initialized
    
    # 如果舵机已经初始化，直接返回
    if servos_initialized and pan_servo is not None and tilt_servo is not None:
        print("✅ 舵机已初始化，跳过重复初始化")
        return True
        
    try:
        pan_servo = Servo(1)
        tilt_servo = Servo(2)

        pan_servo.calibration(500, 2500, 1500)
        tilt_servo.calibration(500, 2500, 1500)

        # 使用更激进的PID参数
        pan_pid = PID(p=0.5, i=0, d=0.01, imax=90)    # 增大P值
        tilt_pid = PID(p=0.5, i=0, d=0.02, imax=90)   # 增大P值

        # 舵机复位到中间位置
        pan_servo.angle(0)
        tilt_servo.angle(0)
        
        servos_initialized = True
        print("✅ 舵机初始化完成")
        
        # 测试舵机响应
        test_servo_response()
        return True
    except Exception as e:
        print(f"❌ 舵机初始化失败: {e}")
        return False

def test_servo_response():
    """测试舵机响应"""
    global pan_servo, tilt_servo
    print("🔧 测试舵机响应...")
    
    # 测试小范围移动
    test_angles = [10, -10, 0]
    for angle in test_angles:
        print(f"🔧 测试角度: {angle}°")
        pan_servo.angle(angle)
        tilt_servo.angle(angle)
        time.sleep_ms(500)
        
        actual_pan = pan_servo.angle()
        actual_tilt = tilt_servo.angle()
        print(f"🔧 实际角度 - Pan: {actual_pan}°, Tilt: {actual_tilt}°")
    
    print("✅ 舵机响应测试完成")

def init_face_cascade():
    """初始化人脸检测"""
    global face_cascade
    try:
        face_cascade = image.HaarCascade("/rom/haarcascade_frontalface.cascade", stages=25)
        print("人脸检测模型加载完成")
        return True
    except Exception as e:
        print(f"❌ 人脸检测模型加载失败: {e}")
        return False

def init_led():
    """初始化LED"""
    global red_led, green_led, blue_led
    try:
        red_led = LED(1)
        green_led = LED(2)
        blue_led = LED(3)
        red_led.off()
        green_led.off()
        blue_led.off()
        print("LED初始化完成")
        return True
    except Exception as e:
        print(f"❌ LED初始化失败: {e}")
        return False

def init_uart():
    """初始化串口"""
    global uart
    try:
        uart = UART(3, 115200)
        uart.init(115200, bits=8, parity=None, stop=1, timeout_char=200)
        print("串口初始化完成 - UART3, 115200bps")
        return True
    except Exception as e:
        print(f"❌ 串口初始化失败: {e}")
        return False

def update_led():
    """简化LED状态更新"""
    global current_led_state, last_led_change
    
    current_time = time.ticks_ms()
    
    if time.ticks_diff(current_time, last_led_change) > led_blink_interval:
        led_blink_state = not led_blink_state
        last_led_change = current_time

        if current_led_state == LED_OFF:
            red_led.off()
            green_led.off()
            blue_led.off()
        elif current_led_state == LED_READY:
            green_led.on()
            red_led.off()
            blue_led.off()
        elif current_led_state == LED_CAMERA_ON:
            green_led.on()
            red_led.off()
            blue_led.off()
        elif current_led_state == LED_TRACKING:
            if led_blink_state:
                blue_led.on()
                green_led.off()
                red_led.off()
            else:
                blue_led.off()
                green_led.off()
                red_led.off()
        elif current_led_state == LED_RECOGNITION:
            blue_led.on()
            green_led.off()
            red_led.off()
        elif current_led_state == LED_ERROR:
            if led_blink_state:
                red_led.on()
                green_led.off()
                blue_led.off()
            else:
                red_led.off()
                green_led.off()
                blue_led.off()
        elif current_led_state == LED_RECONNECTING:
            if led_blink_state:
                red_led.on()
                green_led.on()
                blue_led.off()
            else:
                red_led.off()
                green_led.off()
                blue_led.off()

def set_led_state(state):
    """设置LED状态"""
    global current_led_state, last_led_change
    if current_led_state == state:
        return
    current_led_state = state
    last_led_change = time.ticks_ms()

    # 立即设置LED状态
    if state == LED_OFF:
        red_led.off()
        green_led.off()
        blue_led.off()
    elif state == LED_READY:
        green_led.on()
        red_led.off()
        blue_led.off()
    elif state == LED_CAMERA_ON:
        green_led.on()
        red_led.off()
        blue_led.off()
    elif state == LED_TRACKING:
        blue_led.on()
        green_led.off()
        red_led.off()
    elif state == LED_RECOGNITION:
        blue_led.on()
        green_led.off()
        red_led.off()
    elif state == LED_ERROR:
        red_led.on()
        green_led.off()
        blue_led.off()
    elif state == LED_RECONNECTING:
        red_led.on()
        green_led.on()
        blue_led.off()

def connect_wifi():
    """连接WiFi"""
    try:
        wlan = network.WLAN(network.STA_IF)
        wlan.active(True)
        print("连接WiFi: {}...".format(SSID))

        if wlan.isconnected():
            wlan.disconnect()
            time.sleep(1)

        wlan.connect(SSID, KEY)
        timeout = 30
        while not wlan.isconnected() and timeout > 0:
            time.sleep_ms(500)
            timeout -= 1
            print(".", end="")

        if wlan.isconnected():
            print("\nWiFi连接成功!")
            print("IP地址:", wlan.ifconfig()[0])
            return True
        else:
            print("\nWiFi连接失败!")
            return False
    except Exception as e:
        print(f"❌ WiFi连接异常: {e}")
        return False

def connect_mqtt_socket():
    """使用原始Socket连接MQTT服务器"""
    global mqtt_socket, connect_state
    try:
        print(f"🔗 连接MQTT Socket: {EMQX_BROKER}:{EMQX_PORT}")

        if mqtt_socket:
            try:
                mqtt_socket.close()
            except:
                pass
            mqtt_socket = None
            time.sleep_ms(500)

        addr = socket.getaddrinfo(EMQX_BROKER, EMQX_PORT)[0][-1]
        sock = socket.socket()
        sock.settimeout(8.0)
        sock.connect(addr)
        sock.settimeout(None)
        print("✅ Socket连接成功")

        protocol_name = "MQTT"
        protocol_level = 4
        connect_flags = 0xC2
        keepalive = 60

        variable_header = bytearray()
        variable_header.extend(struct.pack(">H", len(protocol_name)))
        variable_header.extend(protocol_name.encode())
        variable_header.append(protocol_level)
        variable_header.append(connect_flags)
        variable_header.extend(struct.pack(">H", keepalive))

        payload = bytearray()
        payload.extend(struct.pack(">H", len(CLIENT_ID)))
        payload.extend(CLIENT_ID.encode())
        payload.extend(struct.pack(">H", len(EMQX_USERNAME)))
        payload.extend(EMQX_USERNAME.encode())
        payload.extend(struct.pack(">H", len(EMQX_PASSWORD)))
        payload.extend(EMQX_PASSWORD.encode())

        remaining_length = len(variable_header) + len(payload)
        fixed_header = bytearray([0x10, remaining_length])
        connect_packet = fixed_header + variable_header + payload
        sock.send(connect_packet)
        print("已发送CONNECT报文")

        sock.settimeout(5.0)
        connack = sock.recv(4)
        sock.settimeout(None)
        print("CONNACK响应:", connack.hex())

        if connack[0] == 0x20 and connack[3] == 0x00:
            print("✅ MQTT连接成功")
            mqtt_socket = sock
            connect_state = CONNECT_STATE_NORMAL
            set_led_state(LED_READY)
            return True
        else:
            print("❌ MQTT连接失败")
            sock.close()
            connect_state = CONNECT_STATE_ERROR
            set_led_state(LED_ERROR)
            return False
    except Exception as e:
        print(f"❌ MQTT Socket连接失败: {e}")
        try:
            sock.close()
        except:
            pass
        connect_state = CONNECT_STATE_ERROR
        set_led_state(LED_ERROR)
        return False

def publish_message_safe(topic, message):
    """安全地发布消息到MQTT主题"""
    global mqtt_socket, connect_state

    if not mqtt_socket or connect_state != CONNECT_STATE_NORMAL:
        print("❌ MQTT Socket未连接或连接异常")
        connect_state = CONNECT_STATE_ERROR
        return False

    try:
        if isinstance(message, str):
            message_bytes = message.encode('utf-8')
        else:
            message_bytes = message

        if len(message_bytes) > MAX_MESSAGE_SIZE:
            print(f"❌ 消息过长: {len(message_bytes)} > {MAX_MESSAGE_SIZE} 字节")
            return False

        # 简化的MQTT发布实现
        topic_bytes = topic.encode('utf-8')
        remaining_length = 2 + len(topic_bytes) + len(message_bytes)
        
        # 构建固定头部
        fixed_header = bytearray([0x30])
        # 编码剩余长度
        while True:
            digit = remaining_length % 128
            remaining_length //= 128
            if remaining_length > 0:
                digit |= 0x80
            fixed_header.append(digit)
            if remaining_length == 0:
                break
        
        # 构建可变头部
        variable_header = bytearray()
        variable_header.extend(struct.pack(">H", len(topic_bytes)))
        variable_header.extend(topic_bytes)
        
        # 构建完整数据包
        publish_packet = fixed_header + variable_header + message_bytes

        mqtt_socket.settimeout(3.0)
        try:
            bytes_sent = mqtt_socket.send(publish_packet)
            mqtt_socket.settimeout(None)

            if bytes_sent == len(publish_packet):
                return True
            else:
                print(f"❌ 发送不完整: {bytes_sent}/{len(publish_packet)} 字节")
                return False
        except OSError as e:
            mqtt_socket.settimeout(None)
            print(f"❌ 发送失败: {e}")
            try:
                mqtt_socket.close()
            except:
                pass
            mqtt_socket = None
            connect_state = CONNECT_STATE_ERROR
            return False

    except Exception as e:
        print(f"发布消息失败: {e}")
        return False

def attempt_reconnect():
    """尝试重新连接"""
    global reconnect_attempts, last_reconnect_attempt, connect_state

    current_time = time.ticks_ms()
    if time.ticks_diff(current_time, last_reconnect_attempt) < reconnect_delay:
        return False

    if reconnect_attempts >= max_reconnect_attempts:
        print(f"❌ 已达到最大重连次数 ({max_reconnect_attempts})")
        return False

    reconnect_attempts += 1
    last_reconnect_attempt = current_time
    print(f"🔄 尝试重新连接 ({reconnect_attempts}/{max_reconnect_attempts})...")
    set_led_state(LED_RECONNECTING)

    if connect_mqtt_socket():
        print("✅ MQTT重新连接成功")
        return True
    else:
        print(f"❌ MQTT重新连接失败 ({reconnect_attempts}/{max_reconnect_attempts})")
        return False

def compress_frame(img):
    """压缩图像帧"""
    quality = FRAME_QUALITY
    max_attempts = 2

    for attempt in range(max_attempts):
        jpeg_data = img.compress(quality=quality)
        if not isinstance(jpeg_data, bytes):
            jpeg_data = bytes(jpeg_data)

        frame_size = len(jpeg_data)

        if frame_size <= MAX_FRAME_SIZE:
            return jpeg_data, frame_size, quality

        quality = max(20, quality - 20)
        print(f"⚠️ 帧过大 ({frame_size}字节)，降低质量为{quality}%")

    return jpeg_data, frame_size, quality

def send_frame():
    """发送一帧图像"""
    global frame_count, connect_state

    if connect_state != CONNECT_STATE_NORMAL:
        return False

    try:
        img = sensor.snapshot()

        jpeg_data, frame_size, actual_quality = compress_frame(img)

        if frame_size > MAX_FRAME_SIZE:
            print(f"❌ 帧过大 ({frame_size}字节)，跳过此帧")
            return False

        # 根据当前摄像头模式设置格式
        if current_camera_mode == CAMERA_MODE_COLOR:
            format_str = "RGB"
        else:
            format_str = "grayscale"

        message = {
            "frame_id": frame_count,
            "timestamp": time.ticks_ms(),
            "width": img.width(),
            "height": img.height(),
            "quality": actual_quality,
            "size": frame_size,
            "format": format_str,
            "data": jpeg_data.hex()
        }

        message_json = ujson.dumps(message)

        if len(message_json) > MAX_MESSAGE_SIZE:
            print(f"❌ JSON消息过大: {len(message_json)} 字节，跳过此帧")
            return False

        if publish_message_safe(VIDEO_TOPIC, message_json):
            frame_count += 1
            if frame_count % 20 == 0:
                print("📹 已发送 {} 帧, 大小: {} 字节, 质量: {}%, 格式: {}".format(
                    frame_count, frame_size, actual_quality, format_str))
            return True
        else:
            print("❌ 发送帧失败")
            return False

    except Exception as e:
        print("发送帧失败:", e)
        return False

def find_max_face(faces):
    """查找最大的人脸"""
    max_size = 0
    max_face = None
    for face in faces:
        if face[2] * face[3] > max_size:
            max_face = face
            max_size = face[2] * face[3]
    return max_face

def face_tracking():
    """人脸追踪函数 - 优化版本"""
    global pan_servo, tilt_servo, pan_pid, tilt_pid, face_cascade
    global last_angle_print_time, angle_print_interval

    if system_state not in [SYSTEM_STATE_FACE_ON, SYSTEM_STATE_RECOGNITION_ON]:
        return

    # 确保舵机已初始化
    if pan_servo is None or tilt_servo is None:
        print("❌ 舵机未初始化，跳过追踪")
        return

    try:
        # 只在需要时切换模式
        if current_camera_mode != CAMERA_MODE_GRAYSCALE:
            switch_camera_mode(CAMERA_MODE_GRAYSCALE)

        img = sensor.snapshot()
        faces = img.find_features(face_cascade, threshold=0.3, scale_factor=1.5)

        if faces:
            max_face = find_max_face(faces)

            # 计算误差
            face_center_x = max_face[0] + max_face[2] // 2
            face_center_y = max_face[1] + max_face[3] // 2
            pan_error = face_center_x - img.width() // 2
            tilt_error = face_center_y - img.height() // 2

            # 使用较大的PID输出
            pan_output = pan_pid.get_pid(pan_error, 1) * 3.0  # 放大3倍
            tilt_output = tilt_pid.get_pid(tilt_error, 1) * 3.0

            # 确保最小移动量
            min_move = 3.0
            if abs(pan_output) < min_move and abs(pan_error) > 15:
                pan_output = min_move if pan_output >= 0 else -min_move
            if abs(tilt_output) < min_move and abs(tilt_error) > 15:
                tilt_output = min_move if tilt_output >= 0 else -min_move

            # 获取当前角度并计算新角度
            current_pan = pan_servo.angle()
            current_tilt = tilt_servo.angle()
            new_pan = current_pan - pan_output
            new_tilt = current_tilt + tilt_output

            # 限制角度
            new_pan = max(-90, min(90, new_pan))
            new_tilt = max(-60, min(45, new_tilt))

            # 打印详细信息
            current_time = time.ticks_ms()
            if time.ticks_diff(current_time, last_angle_print_time) > angle_print_interval:
                print(f"🎯 误差 - Pan: {pan_error}px, Tilt: {tilt_error}px")
                print(f"🎯 PID输出 - Pan: {pan_output:.2f}°, Tilt: {tilt_output:.2f}°")
                print(f"🎯 角度变化 - Pan: {current_pan:.1f}° → {new_pan:.1f}°")
                print(f"🎯 角度变化 - Tilt: {current_tilt:.1f}° → {new_tilt:.1f}°")
                last_angle_print_time = current_time

            # 设置舵机角度
            pan_servo.angle(new_pan)
            tilt_servo.angle(new_tilt)

        else:
            # 如果没有检测到人脸，重置PID积分项
            pan_pid.reset_I()
            tilt_pid.reset_I()

    except Exception as e:
        print(f"❌ 人脸追踪错误: {e}")

def send_control_command(command):
    """发送控制命令到Flask"""
    control_msg = {
        "command": command,
        "client_id": CLIENT_ID,
        "timestamp": time.ticks_ms()
    }

    success = publish_message_safe(FLASK_CONTROL_TOPIC, ujson.dumps(control_msg))
    if success:
        print(f"✅ 已发送控制命令: {command}")
    else:
        print(f"❌ 发送控制命令失败: {command}")

    return success

def process_serial_command():
    """处理串口命令 - 简化版本"""
    global system_state, uart

    if uart is None:
        return

    if uart.any():
        data = uart.read(1)
        print(f"📟 接收到串口命令: {data}")

        if data == b'0':
            # 直接开启人脸追踪
            system_state = SYSTEM_STATE_FACE_ON
            set_led_state(LED_TRACKING)
            switch_camera_mode(CAMERA_MODE_GRAYSCALE)
            print("✅ 开始人脸追踪")

        elif data == b'1':
            # 仅开启摄像头
            system_state = SYSTEM_STATE_CAMERA_ON
            set_led_state(LED_CAMERA_ON)
            switch_camera_mode(CAMERA_MODE_COLOR)
            print("✅ 摄像头开启")

        elif data == b'2':
            # 开启人脸识别
            system_state = SYSTEM_STATE_RECOGNITION_ON
            set_led_state(LED_RECOGNITION)
            switch_camera_mode(CAMERA_MODE_GRAYSCALE)
            send_control_command("start_recognition")
            print("✅ 开启人脸识别")

        elif data == b'3':
            # 关闭人脸识别
            if system_state == SYSTEM_STATE_RECOGNITION_ON:
                system_state = SYSTEM_STATE_FACE_ON
                set_led_state(LED_TRACKING)
                send_control_command("stop_recognition")
                print("✅ 关闭人脸识别")

        elif data == b'4':
            # 关闭摄像头并复位
            system_state = SYSTEM_STATE_OFF
            set_led_state(LED_OFF)
            pan_servo.angle(0)
            tilt_servo.angle(0)
            switch_camera_mode(CAMERA_MODE_COLOR)
            send_control_command("stop_recognition")
            print("✅ 摄像头关闭，舵机复位")

def send_status():
    """发送状态信息"""
    global frame_count, connect_state

    if connect_state != CONNECT_STATE_NORMAL:
        return False

    # 根据当前摄像头模式设置格式
    if current_camera_mode == CAMERA_MODE_COLOR:
        format_str = "RGB"
    else:
        format_str = "grayscale"

    status_msg = {
        "frames_sent": frame_count,
        "memory_free": gc.mem_free(),
        "status": "streaming",
        "client_id": CLIENT_ID,
        "system_state": system_state,
        "format": format_str
    }

    if publish_message_safe(STATUS_TOPIC, ujson.dumps(status_msg)):
        print("📊 状态: 帧数={}, 内存={}字节, 系统状态={}, 格式={}".format(
            frame_count, gc.mem_free(), system_state, format_str))
        return True
    else:
        print("❌ 发送状态失败")
        return False

def main():
    """主函数 - 优化版本"""
    global system_state

    print("=== OpenMV EMQX追踪系统 V6 ===")
    print(f"客户端ID: {CLIENT_ID}")

    # 初始化硬件
    if not init_camera(CAMERA_MODE_COLOR):
        print("❌ 摄像头初始化失败，程序退出")
        return

    if not init_servos():
        print("⚠️ 舵机初始化失败，继续运行")

    if not init_face_cascade():
        print("⚠️ 人脸检测初始化失败，继续运行")

    if not init_led():
        print("⚠️ LED初始化失败，继续运行")

    if not init_uart():
        print("⚠️ 串口初始化失败，继续运行")

    set_led_state(LED_OFF)

    # 网络连接
    if not connect_wifi():
        print("❌ WiFi连接失败，程序退出")
        return

    if not connect_mqtt_socket():
        print("❌ MQTT连接失败，程序退出")
        return

    print("\n🚀 系统就绪! 等待串口指令...")
    print("串口指令:")
    print("  0: 开始人脸追踪")
    print("  1: 摄像头开启")
    print("  2: 开启人脸识别")
    print("  3: 关闭人脸识别")
    print("  4: 关闭摄像头")

    last_status_time = time.ticks_ms()
    last_debug_time = time.ticks_ms()

    while True:
        current_time = time.ticks_ms()
        update_led()

        # 处理串口命令
        process_serial_command()

        # 根据连接状态处理不同情况
        if connect_state == CONNECT_STATE_ERROR:
            if attempt_reconnect():
                print("✅ 重连成功，恢复运行")
            else:
                time.sleep_ms(2000)
        else:
            # 正常状态下的操作
            if system_state >= SYSTEM_STATE_CAMERA_ON:
                send_frame()

            if system_state >= SYSTEM_STATE_FACE_ON:
                face_tracking()

            # 定期发送状态
            if time.ticks_diff(current_time, last_status_time) > 15000:
                send_status()
                gc.collect()
                last_status_time = current_time

            # 定期调试信息
            if time.ticks_diff(current_time, last_debug_time) > 5000:
                if pan_servo and tilt_servo:
                    print(f"🔍 系统状态: {system_state}, 舵机角度 - Pan: {pan_servo.angle():.1f}°, Tilt: {tilt_servo.angle():.1f}°")
                last_debug_time = current_time

        time.sleep_ms(int(1000 / TARGET_FPS))

if __name__ == "__main__":
    try:
        main()
    except Exception as e:
        print("程序错误:", e)
        set_led_state(LED_ERROR)
        time.sleep(5000)
        machine.reset()
    finally:
        if mqtt_socket:
            try:
                mqtt_socket.close()
            except:
                pass
        if 'red_led' in globals():
            red_led.off()
        if 'green_led' in globals():
            green_led.off()
        if 'blue_led' in globals():
            blue_led.off()
        print("程序结束")
        