# mqtt_test.py - 简单的MQTT连接测试
import network
import time
from mqtt import MQTTClient

# WiFi配置
SSID = "MTCPC"
KEY = "mt12345mt"

# MQTT配置
BROKER = "192.168.13.225"
PORT = 1883
USERNAME = "sy"
PASSWORD = "123"

def connect_wifi():
    wlan = network.WLAN(network.STA_IF)
    wlan.active(True)
    
    if wlan.isconnected():
        print("已连接WiFi，IP:", wlan.ifconfig()[0])
        return True
        
    print("连接WiFi...")
    wlan.connect(SSID, KEY)
    
    for i in range(30):
        if wlan.isconnected():
            ip = wlan.ifconfig()[0]
            if ip != "0.0.0.0":
                print("WiFi连接成功! IP:", ip)
                return True
        time.sleep_ms(500)
        print(".", end="")
    
    print("\nWiFi连接失败")
    return False

def test_mqtt():
    print("测试MQTT连接...")
    
    try:
        # 尝试不同的客户端ID格式
        client_id = "openmv_test"
        print("客户端ID:", client_id)
        print("服务器:", BROKER)
        print("端口:", PORT)
        print("用户名:", USERNAME)
        
        client = MQTTClient(client_id, BROKER, port=PORT, user=USERNAME, password=PASSWORD)
        print("MQTT客户端创建成功")
        
        client.connect()
        print("MQTT连接成功!")
        
        client.disconnect()
        print("MQTT断开连接成功")
        return True
        
    except Exception as e:
        print("MQTT测试失败:", e)
        return False

if __name__ == "__main__":
    if connect_wifi():
        test_mqtt()
    else:
        print("无法连接WiFi")
        