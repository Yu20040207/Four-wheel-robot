# openmv_emqx_stream_high_quality_fixed.py
import sensor
import network
import time
import socket
import struct
import ujson
import gc
import machine
from pyb import LED

# 配置区域
SSID = "MTCPC"
KEY = "mt12345mt"

# EMQX服务器配置
EMQX_BROKER = "192.168.13.225"
EMQX_PORT = 1883
EMQX_USERNAME = "sy"
EMQX_PASSWORD = "123"

# MQTT主题
VIDEO_TOPIC = "openmv/video/stream"
STATUS_TOPIC = "openmv/status"
RECOGNITION_RESULT_TOPIC = "openmv_recognition_result"
RECOGNITION_ACK_TOPIC = "openmv/recognition_ack"

# 视频流配置 - 优化为更稳定的设置
FRAME_SIZE = sensor.QVGA  # 320x240
FRAME_QUALITY = 60        # 中等质量以提高稳定性
TARGET_FPS = 3           # 降低帧率以提高稳定性
MAX_FRAME_SIZE = 15000   # 限制帧大小

ENABLE_FRAME_SKIP = True
FRAME_SKIP_COUNT = 2      # 每3帧发送1帧

# 全局变量
mqtt_socket = None
frame_count = 0
last_recognition_time = 0
received_messages = []
message_buffer = bytearray()
CLIENT_ID = "openmv_camera_001"

# LED变量
red_led = None
green_led = None
blue_led = None

# LED状态常量
LED_NORMAL = 0      # 正常运行 - 绿色灯持续闪烁
LED_ERROR = 1       # 出现问题 - 红色灯持续闪烁
LED_RECOGNITION = 2 # 收到识别 - 蓝色灯闪烁一次
LED_RECONNECTING = 3 # 重连中 - 黄色灯闪烁

# LED状态变量
current_led_state = LED_NORMAL
led_blink_state = False
last_led_change = 0
recognition_led_start = 0

# 连接状态
CONNECT_STATE_NORMAL = 0
CONNECT_STATE_ERROR = 1
CONNECT_STATE_RECONNECTING = 2
connect_state = CONNECT_STATE_NORMAL
reconnect_attempts = 0
max_reconnect_attempts = 10  # 增加最大重连次数
reconnect_delay = 3000      # 减少重连延迟

# 性能监控
last_status_time = 0
send_errors = 0
max_send_errors = 5

def init_camera():
    """初始化摄像头"""
    sensor.reset()
    sensor.set_pixformat(sensor.RGB565)
    sensor.set_framesize(FRAME_SIZE)

    # 优化设置
    sensor.set_auto_whitebal(True)
    sensor.set_auto_gain(False)
    sensor.set_auto_exposure(False, exposure_us=10000)

    sensor.set_contrast(1)
    sensor.set_saturation(1)
    sensor.set_brightness(0)

    sensor.skip_frames(30)

    print("摄像头初始化完成 - 分辨率: {}x{}".format(sensor.width(), sensor.height()))
    print("图像质量设置: 质量={}%, 帧率={}fps".format(FRAME_QUALITY, TARGET_FPS))

def init_led():
    """初始化LED"""
    global red_led, green_led, blue_led, current_led_state, led_blink_state, last_led_change, recognition_led_start

    try:
        red_led = LED(1)
        green_led = LED(2)
        blue_led = LED(3)

        red_led.off()
        green_led.off()
        blue_led.off()

        # 初始化LED状态变量
        current_led_state = LED_NORMAL
        led_blink_state = False
        last_led_change = time.ticks_ms()
        recognition_led_start = 0

        print("LED初始化完成")
        return True
    except Exception as e:
        print(f"LED初始化失败: {e}")
        red_led = None
        green_led = None
        blue_led = None
        return False

def update_led():
    """更新LED状态"""
    global current_led_state, led_blink_state, last_led_change, recognition_led_start

    if red_led is None:
        return

    current_time = time.ticks_ms()

    if current_led_state == LED_RECOGNITION:
        if recognition_led_start == 0:
            recognition_led_start = current_time
            blue_led.on()
            green_led.off()
            red_led.off()
        elif time.ticks_diff(current_time, recognition_led_start) > 300:
            blue_led.off()
            recognition_led_start = 0
            current_led_state = LED_NORMAL
            last_led_change = current_time
        return

    if current_led_state == LED_RECONNECTING:
        if time.ticks_diff(current_time, last_led_change) > 300:
            led_blink_state = not led_blink_state
            last_led_change = current_time
            if led_blink_state:
                red_led.on()
                green_led.on()
                blue_led.off()
            else:
                red_led.off()
                green_led.off()
                blue_led.off()
        return

    if time.ticks_diff(current_time, last_led_change) > 500:
        led_blink_state = not led_blink_state
        last_led_change = current_time

        if current_led_state == LED_NORMAL:
            if led_blink_state:
                green_led.on()
                red_led.off()
                blue_led.off()
            else:
                green_led.off()
                red_led.off()
                blue_led.off()
        elif current_led_state == LED_ERROR:
            if led_blink_state:
                red_led.on()
                green_led.off()
                blue_led.off()
            else:
                red_led.off()
                green_led.off()
                blue_led.off()

def set_led_state(state):
    """设置LED状态"""
    global current_led_state, last_led_change, recognition_led_start

    if red_led is None:
        return

    if current_led_state == state and state != LED_RECOGNITION:
        return

    current_led_state = state
    last_led_change = time.ticks_ms()
    recognition_led_start = 0

    if state == LED_NORMAL:
        green_led.on()
        red_led.off()
        blue_led.off()
        led_blink_state = True
    elif state == LED_ERROR:
        red_led.on()
        green_led.off()
        blue_led.off()
        led_blink_state = True
    elif state == LED_RECONNECTING:
        red_led.on()
        green_led.on()
        blue_led.off()
        led_blink_state = True
    elif state == LED_RECOGNITION:
        # 将在update_led中处理
        pass

def connect_wifi():
    """连接WiFi - 增强版本"""
    wlan = network.WLAN(network.STA_IF)
    wlan.active(True)

    # 检查是否已连接
    if wlan.isconnected():
        print(f"WiFi已连接，IP: {wlan.ifconfig()[0]}")
        return True

    print(f"连接WiFi: {SSID}...")
    wlan.connect(SSID, KEY)

    timeout = 20
    for i in range(timeout):
        if wlan.isconnected():
            print(f"\nWiFi连接成功!")
            print("IP地址:", wlan.ifconfig()[0])
            return True
        time.sleep_ms(500)
        print(".", end="")

    print("\nWiFi连接失败!")
    return False

def check_wifi_connection():
    """检查WiFi连接状态"""
    wlan = network.WLAN(network.STA_IF)
    return wlan.isconnected()

def reconnect_wifi_if_needed():
    """如果需要则重新连接WiFi"""
    if not check_wifi_connection():
        print("WiFi连接断开，尝试重新连接...")
        set_led_state(LED_RECONNECTING)
        if connect_wifi():
            print("WiFi重新连接成功")
            set_led_state(LED_NORMAL)
            return True
        else:
            print("WiFi重新连接失败")
            set_led_state(LED_ERROR)
            return False
    return True

def subscribe_topic(sock, topic):
    """订阅主题"""
    try:
        packet_id = 1
        subscribe_payload = bytearray()
        subscribe_payload.extend(struct.pack(">H", packet_id))
        subscribe_payload.extend(struct.pack(">H", len(topic)))
        subscribe_payload.extend(topic.encode())
        subscribe_payload.append(0)

        remaining_len = len(subscribe_payload)
        subscribe_packet = bytearray([0x82, remaining_len]) + subscribe_payload
        sock.send(subscribe_packet)

        # 设置超时接收
        sock.settimeout(2.0)
        suback = sock.recv(5)
        sock.settimeout(None)

        print(f"✅ 成功订阅主题: {topic}")
        return True

    except Exception as e:
        print(f"订阅主题失败: {e}")
        return False

def connect_mqtt_socket():
    """使用原始Socket连接MQTT服务器 - 增强版本"""
    global mqtt_socket, connect_state, reconnect_attempts

    try:
        print(f"🔗 连接MQTT: {EMQX_BROKER}:{EMQX_PORT}")

        # 清理旧连接
        if mqtt_socket:
            try:
                mqtt_socket.close()
            except:
                pass
            mqtt_socket = None
            time.sleep_ms(100)

        # 创建新连接
        addr = socket.getaddrinfo(EMQX_BROKER, EMQX_PORT)[0][-1]
        sock = socket.socket()
        sock.settimeout(5.0)  # 设置连接超时
        sock.connect(addr)
        sock.settimeout(None)
        print("✅ Socket连接成功")

        # MQTT连接报文
        protocol_name = "MQTT"
        protocol_level = 4
        connect_flags = 0xC2
        keepalive = 60

        variable_header = bytearray()
        variable_header.extend(struct.pack(">H", len(protocol_name)))
        variable_header.extend(protocol_name.encode())
        variable_header.append(protocol_level)
        variable_header.append(connect_flags)
        variable_header.extend(struct.pack(">H", keepalive))

        payload = bytearray()
        payload.extend(struct.pack(">H", len(CLIENT_ID)))
        payload.extend(CLIENT_ID.encode())
        payload.extend(struct.pack(">H", len(EMQX_USERNAME)))
        payload.extend(EMQX_USERNAME.encode())
        payload.extend(struct.pack(">H", len(EMQX_PASSWORD)))
        payload.extend(EMQX_PASSWORD.encode())

        remaining_length = len(variable_header) + len(payload)
        fixed_header = bytearray([0x10, remaining_length])

        connect_packet = fixed_header + variable_header + payload
        sock.send(connect_packet)
        print("已发送CONNECT报文")

        # 接收CONNACK
        sock.settimeout(3.0)
        connack = sock.recv(4)
        sock.settimeout(None)

        print("CONNACK响应:", connack.hex())

        if connack[0] == 0x20 and connack[3] == 0x00:
            print("✅ MQTT连接成功")

            # 订阅主题
            if subscribe_topic(sock, RECOGNITION_RESULT_TOPIC):
                mqtt_socket = sock
                connect_state = CONNECT_STATE_NORMAL
                reconnect_attempts = 0
                send_errors = 0
                set_led_state(LED_NORMAL)
                return True
            else:
                print("❌ 订阅主题失败")
                sock.close()
                connect_state = CONNECT_STATE_ERROR
                set_led_state(LED_ERROR)
                return False
        else:
            print("❌ MQTT连接失败")
            sock.close()
            connect_state = CONNECT_STATE_ERROR
            set_led_state(LED_ERROR)
            return False

    except Exception as e:
        print(f"❌ MQTT连接失败: {e}")
        connect_state = CONNECT_STATE_ERROR
        set_led_state(LED_ERROR)
        return False

def encode_remaining_length(length):
    """编码MQTT剩余长度字段"""
    encoded = bytearray()
    while True:
        digit = length % 128
        length //= 128
        if length > 0:
            digit |= 0x80
        encoded.append(digit)
        if length == 0:
            break
    return encoded

def publish_message_safe(topic, message):
    """安全地发布消息到MQTT主题 - 增强版本"""
    global mqtt_socket, connect_state, send_errors

    if not mqtt_socket or connect_state != CONNECT_STATE_NORMAL:
        print("❌ MQTT Socket未连接")
        return False

    try:
        if isinstance(message, str):
            message_bytes = message.encode('utf-8')
        else:
            message_bytes = message

        # 检查消息长度
        if len(message_bytes) > 65535:
            print(f"❌ 消息过长: {len(message_bytes)} 字节")
            return False

        fixed_header = bytearray([0x30])

        variable_header = bytearray()
        topic_bytes = topic.encode('utf-8')
        variable_header.extend(struct.pack(">H", len(topic_bytes)))
        variable_header.extend(topic_bytes)

        payload = message_bytes

        remaining_length = len(variable_header) + len(payload)
        encoded_remaining = encode_remaining_length(remaining_length)
        fixed_header.extend(encoded_remaining)

        publish_packet = fixed_header + variable_header + payload

        # 尝试发送数据
        try:
            bytes_sent = mqtt_socket.send(publish_packet)
            if bytes_sent == len(publish_packet):
                send_errors = 0  # 重置错误计数
                return True
            else:
                print(f"❌ 发送不完整: {bytes_sent}/{len(publish_packet)} 字节")
                send_errors += 1
                return False

        except OSError as e:
            print(f"❌ 发送失败: {e}")
            send_errors += 1
            return False

    except Exception as e:
        print(f"发布消息失败: {e}")
        send_errors += 1
        return False

def attempt_reconnect():
    """尝试重新连接 - 增强版本"""
    global reconnect_attempts, connect_state, send_errors

    if reconnect_attempts >= max_reconnect_attempts:
        print(f"❌ 已达到最大重连次数 ({max_reconnect_attempts})")
        connect_state = CONNECT_STATE_ERROR
        set_led_state(LED_ERROR)
        return False

    reconnect_attempts += 1
    print(f"🔄 尝试重新连接 ({reconnect_attempts}/{max_reconnect_attempts})...")
    set_led_state(LED_RECONNECTING)

    # 1. 先检查并重新连接WiFi
    if not reconnect_wifi_if_needed():
        print("WiFi重连失败，无法继续MQTT重连")
        return False

    # 2. 重新连接MQTT
    if connect_mqtt_socket():
        print("✅ MQTT重新连接成功")
        send_errors = 0
        return True
    else:
        print(f"❌ MQTT重新连接失败 ({reconnect_attempts}/{max_reconnect_attempts})")
        return False

def check_and_process_messages():
    """检查并处理接收到的MQTT消息"""
    global mqtt_socket, message_buffer, received_messages, connect_state

    if not mqtt_socket or connect_state != CONNECT_STATE_NORMAL:
        return

    try:
        mqtt_socket.setblocking(False)
        try:
            chunk = mqtt_socket.recv(512)  # 减少缓冲区大小
            if chunk:
                message_buffer.extend(chunk)
        except OSError:
            pass  # 没有数据可读是正常的

        # 处理消息缓冲区
        while len(message_buffer) >= 2:
            packet_type = message_buffer[0] & 0xF0

            if packet_type == 0x30:  # PUBLISH
                topic, message = parse_mqtt_publish_safe(message_buffer)
                if topic and message is not None:
                    received_messages.append((topic, message))
                    print(f"📨 收到消息 - 主题: {topic}, 长度: {len(message)}字节")
                break  # 一次只处理一个消息
            else:
                # 移除已处理的数据
                message_buffer = message_buffer[1:]

        process_received_messages()

    except Exception as e:
        print(f"检查消息时出错: {e}")
        connect_state = CONNECT_STATE_ERROR

def parse_mqtt_publish_safe(data):
    """安全地解析MQTT PUBLISH报文"""
    try:
        if len(data) < 2:
            return None, None

        if (data[0] & 0xF0) != 0x30:
            return None, None

        # 解析剩余长度
        multiplier = 1
        value = 0
        pos = 1

        while pos < len(data):
            encoded_byte = data[pos]
            value += (encoded_byte & 127) * multiplier
            multiplier *= 128
            pos += 1
            if (encoded_byte & 128) == 0:
                break
            if multiplier > 128 * 128 * 128:
                return None, None

        remaining_length = value
        total_length = pos + remaining_length

        if len(data) < total_length:
            return None, None

        # 解析主题
        if len(data) < pos + 2:
            return None, None
        topic_length = struct.unpack(">H", data[pos:pos+2])[0]

        if len(data) < pos + 2 + topic_length:
            return None, None

        topic = data[pos+2:pos+2+topic_length].decode('utf-8')

        # 解析消息
        message_start = pos + 2 + topic_length
        message = data[message_start:total_length]

        # 从缓冲区移除已处理的数据
        global message_buffer
        message_buffer = message_buffer[total_length:]

        return topic, message

    except Exception as e:
        print(f"解析MQTT报文错误: {e}")
        return None, None

def process_received_messages():
    """处理已接收的消息"""
    global received_messages, last_recognition_time

    for topic, message in received_messages:
        try:
            if isinstance(message, bytes):
                msg_str = message.decode('utf-8')
            else:
                msg_str = message

            print(f"处理消息 - 主题: {topic}, 内容: {msg_str}")

            data = ujson.loads(msg_str)

            if topic == RECOGNITION_RESULT_TOPIC:
                recognized_names = data.get("recognized_names", [])
                count = data.get("count", 0)

                if count > 0:
                    print("\n" + "="*40)
                    print("🎯 人脸识别结果:")
                    print("  识别到 {} 个人:".format(count))
                    for i, name in enumerate(recognized_names):
                        print("  👤 {}: {}".format(i+1, name))
                    print("="*40)

                    ack_message = {
                        "status": "received",
                        "recognized_names": recognized_names,
                        "count": count,
                        "client_timestamp": time.ticks_ms()
                    }
                    publish_message_safe(RECOGNITION_ACK_TOPIC, ujson.dumps(ack_message))
                    print("📨 已发送确认消息")

                    last_recognition_time = time.ticks_ms()
                    set_led_state(LED_RECOGNITION)
                else:
                    print("\n❌ 未识别到任何人脸")

        except Exception as e:
            print("处理消息失败:", e)

    received_messages = []

def compress_image_optimized(img):
    """优化图像压缩，确保大小可控"""
    global FRAME_QUALITY

    # 第一次压缩
    quality = FRAME_QUALITY
    jpeg_data = img.compress(quality=quality)
    frame_size = len(jpeg_data)

    # 如果太大，逐步降低质量
    retry_count = 0
    while frame_size > MAX_FRAME_SIZE and retry_count < 3:
        quality = max(20, quality - 20)  # 每次降低20%质量，最低20%
        jpeg_data = img.compress(quality=quality)
        frame_size = len(jpeg_data)
        retry_count += 1

        if frame_size <= MAX_FRAME_SIZE:
            print(f"⚠️ 质量调整为{quality}%以适应网络")
            break

    return jpeg_data, frame_size, quality

def send_frame():
    """发送一帧图像 - 优化版本"""
    global frame_count, connect_state, send_errors

    if connect_state != CONNECT_STATE_NORMAL:
        return False

    # 跳帧逻辑
    if ENABLE_FRAME_SKIP and frame_count % (FRAME_SKIP_COUNT + 1) != 0:
        frame_count += 1
        return False

    try:
        img = sensor.snapshot()

        # 优化图像压缩
        jpeg_data, frame_size, actual_quality = compress_image_optimized(img)

        if frame_size > MAX_FRAME_SIZE:
            print(f"❌ 帧过大 ({frame_size}字节)，跳过此帧")
            frame_count += 1
            return False

        message = {
            "frame_id": frame_count,
            "timestamp": time.ticks_ms(),
            "width": img.width(),
            "height": img.height(),
            "quality": actual_quality,
            "size": frame_size,
            "data": jpeg_data.hex()
        }

        if publish_message_safe(VIDEO_TOPIC, ujson.dumps(message)):
            frame_count += 1

            if frame_count % 10 == 0:  # 减少打印频率
                print("📹 已发送 {} 帧, 大小: {} 字节".format(frame_count, frame_size))

            return True
        else:
            print("❌ 发送帧失败")
            return False

    except Exception as e:
        print("发送帧失败:", e)
        send_errors += 1
        return False

def send_status():
    """发送状态信息"""
    global frame_count, last_recognition_time, connect_state, send_errors

    if connect_state != CONNECT_STATE_NORMAL:
        return False

    status_msg = {
        "frames_sent": frame_count,
        "memory_free": gc.mem_free(),
        "status": "streaming",
        "send_errors": send_errors,
        "client_id": CLIENT_ID,
        "resolution": "{}x{}".format(sensor.width(), sensor.height())
    }

    if publish_message_safe(STATUS_TOPIC, ujson.dumps(status_msg)):
        print("📊 状态: 帧数={}, 错误={}, 内存={}字节".format(
            frame_count, send_errors, gc.mem_free()))
        return True
    else:
        print("❌ 发送状态失败")
        return False

def check_connection_health():
    """检查连接健康状况"""
    global send_errors, connect_state

    # 如果发送错误太多，标记为需要重连
    if send_errors >= max_send_errors:
        print(f"⚠️ 发送错误过多 ({send_errors})，触发重连")
        connect_state = CONNECT_STATE_ERROR
        return False

    return True

def main():
    """主函数"""
    print("=== OpenMV EMQX稳定视频流 ===")
    print(f"客户端ID: {CLIENT_ID}")

    # 初始化硬件
    init_camera()
    init_led()
    set_led_state(LED_NORMAL)

    # 连接WiFi
    if not connect_wifi():
        print("❌ WiFi连接失败，程序退出")
        set_led_state(LED_ERROR)
        return

    # 连接MQTT
    if not connect_mqtt_socket():
        print("❌ MQTT连接失败，程序退出")
        set_led_state(LED_ERROR)
        return

    print("\n🚀 系统就绪! 开始稳定视频流传输...")
    print("分辨率: {}x{}, FPS: {}, 质量: {}%".format(
        sensor.width(), sensor.height(), TARGET_FPS, FRAME_QUALITY))
    print("最大帧大小: {}字节".format(MAX_FRAME_SIZE))

    last_status_time = time.ticks_ms()
    last_health_check = time.ticks_ms()

    while True:
        current_time = time.ticks_ms()

        # 更新LED状态
        update_led()

        # 检查连接状态
        if connect_state == CONNECT_STATE_ERROR:
            if attempt_reconnect():
                print("✅ 重连成功，恢复视频流")
            else:
                time.sleep_ms(2000)  # 重连失败时等待
        else:
            # 正常状态下的操作
            check_and_process_messages()

            # 发送视频帧
            send_frame()

            # 定期发送状态和健康检查
            if time.ticks_diff(current_time, last_status_time) > 15000:  # 15秒
                send_status()
                gc.collect()
                last_status_time = current_time

            if time.ticks_diff(current_time, last_health_check) > 5000:  # 5秒
                if not check_connection_health():
                    print("⚠️ 连接健康状况不佳")
                last_health_check = current_time

        # 控制帧率
        time.sleep_ms(int(1000 / TARGET_FPS))

if __name__ == "__main__":
    try:
        main()
    except Exception as e:
        print("程序错误:", e)
        import sys
        sys.print_exception(e)
        set_led_state(LED_ERROR)
    finally:
        # 安全关闭
        if mqtt_socket:
            try:
                mqtt_socket.close()
            except:
                pass
        if red_led: red_led.off()
        if green_led: green_led.off()
        if blue_led: blue_led.off()
        print("程序结束")
