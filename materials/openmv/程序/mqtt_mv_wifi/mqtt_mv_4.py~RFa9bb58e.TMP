# openmv_emqx_working.py
import sensor
import network
import time
from mqtt import MQTTClient
import ujson
import gc

# 配置区域
SSID = "MTCPC"
KEY = "mt12345mt"

# EMQX服务器配置
EMQX_BROKER = "192.168.13.225"
EMQX_PORT = 1883
EMQX_USERNAME = "sy"
EMQX_PASSWORD = "123"

# MQTT主题
VIDEO_TOPIC = "openmv/video/stream"

# 视频流配置
FRAME_SIZE = sensor.QQVGA  # 160x120
FRAME_QUALITY = 50
TARGET_FPS = 8

def init_camera():
    """初始化摄像头"""
    sensor.reset()
    sensor.set_pixformat(sensor.RGB565)
    sensor.set_framesize(FRAME_SIZE)
    sensor.skip_frames(20)
    sensor.set_auto_whitebal(False)
    sensor.set_auto_gain(False)
    sensor.set_auto_exposure(False, exposure_us=20000)
    print("摄像头初始化完成 - 分辨率: {}x{}".format(sensor.width(), sensor.height()))

def connect_wifi():
    """连接WiFi"""
    wlan = network.WLAN(network.STA_IF)
    wlan.active(True)

    print("连接WiFi: {}...".format(SSID))

    if wlan.isconnected():
        wlan.disconnect()
        time.sleep(1)

    wlan.connect(SSID, KEY)

    timeout = 30
    while not wlan.isconnected() and timeout > 0:
        time.sleep_ms(500)
        timeout -= 1
        print(".", end="")

    if wlan.isconnected():
        print("\nWiFi连接成功!")
        print("IP地址:", wlan.ifconfig()[0])
        return True
    else:
        print("\nWiFi连接失败!")
        return False

def create_mqtt_client():
    """创建MQTT客户端"""
    try:
        client_id = "openmv_{}".format(time.ticks_ms())
        print("创建MQTT客户端...")
        print("服务器: {}".format(EMQX_BROKER))
        print("端口: {}".format(EMQX_PORT))
        print("客户端ID: {}".format(client_id))

        client = MQTTClient(
            client_id,
            EMQX_BROKER,
            port=EMQX_PORT,
            user=EMQX_USERNAME,
            password=EMQX_PASSWORD,
            keepalive=60
        )
        return client
    except Exception as e:
        print("创建MQTT客户端失败:", e)
        return None

def connect_mqtt_with_retry():
    """带重试的MQTT连接"""
    max_retries = 3
    retry_delay = 5  # 秒

    for attempt in range(max_retries):
        print("MQTT连接尝试 {}/{}".format(attempt + 1, max_retries))

        client = create_mqtt_client()
        if not client:
            print("无法创建客户端")
            continue

        try:
            client.connect()
            print("MQTT连接成功!")
            return client
        except Exception as e:
            print("连接失败:", e)
            if attempt < max_retries - 1:
                print("{}秒后重试...".format(retry_delay))
                time.sleep(retry_delay)

    return None

def send_frame_safe(client, frame_count):
    """安全地发送帧"""
    try:
        # 捕获图像
        img = sensor.snapshot()

        # 压缩为JPEG
        jpeg_data = img.compress(quality=FRAME_QUALITY)
        if not isinstance(jpeg_data, bytes):
            jpeg_data = bytes(jpeg_data)

        # 构建简化消息
        message = {
            "frame_id": frame_count,
            "timestamp": time.ticks_ms(),
            "data": jpeg_data.hex()
        }

        # 发布消息
        client.publish(VIDEO_TOPIC, ujson.dumps(message))

        if frame_count % 30 == 0:
            print("已发送 {} 帧".format(frame_count))

        return frame_count + 1

    except Exception as e:
        print("发送帧失败:", e)
        return frame_count

def main():
    """主函数"""
    print("=== OpenMV EMQX视频流 - 工作版本 ===")

    # 初始化摄像头
    init_camera()

    # 连接WiFi
    if not connect_wifi():
        return

    # 连接MQTT
    client = connect_mqtt_with_retry()
    if not client:
        print("无法连接MQTT服务器，程序退出")
        return

    print("系统就绪! 开始视频流传输...")
    print("分辨率: {}x{}, FPS: {}, 质量: {}%".format(
        sensor.width(), sensor.height(), TARGET_FPS, FRAME_QUALITY))

    frame_count = 0
    last_status_time = time.ticks_ms()

    while True:
        current_time = time.ticks_ms()

        # 发送视频帧
        frame_count = send_frame_safe(client, frame_count)

        # 定期显示状态
        if time.ticks_diff(current_time, last_status_time) > 30000:
            print("状态: 运行中... 已发送 {} 帧".format(frame_count))
            gc.collect()
            last_status_time = current_time

        # 控制帧率
        time.sleep_ms(int(1000 / TARGET_FPS))

if __name__ == "__main__":
    try:
        main()
    except Exception as e:
        print("程序错误:", e)
    finally:
        print("程序结束")
