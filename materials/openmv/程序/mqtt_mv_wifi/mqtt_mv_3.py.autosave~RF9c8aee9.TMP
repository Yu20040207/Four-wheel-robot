# openmv_emqx_stream_fixed_socket_v3.py
import sensor
import network
import time
import socket
import struct
import ujson
import gc
import machine

# 配置区域
SSID = "MTCPC"
KEY = "mt12345mt"

# EMQX服务器配置
EMQX_BROKER = "192.168.13.225"
EMQX_PORT = 1883
EMQX_USERNAME = "sy"
EMQX_PASSWORD = "123"

# MQTT主题
VIDEO_TOPIC = "openmv/video/stream"
STATUS_TOPIC = "openmv/status"
RECOGNITION_RESULT_TOPIC = "openmv_recognition_result"
RECOGNITION_ACK_TOPIC = "openmv/recognition_ack"

# 视频流配置
FRAME_SIZE = sensor.QQVGA  # 改为QQVGA (160x120) 减小分辨率
FRAME_QUALITY = 30  # 降低质量
TARGET_FPS = 5  # 降低帧率

# 全局变量
mqtt_socket = None
frame_count = 0
last_recognition_time = 0
received_messages = []
message_buffer = bytearray()
# 使用固定的客户端ID
CLIENT_ID = "openmv_camera_001"

def init_camera():
    """初始化摄像头"""
    sensor.reset()
    sensor.set_pixformat(sensor.RGB565)
    sensor.set_framesize(FRAME_SIZE)
    sensor.skip_frames(20)
    sensor.set_auto_whitebal(False)
    sensor.set_auto_gain(False)
    sensor.set_auto_exposure(False, exposure_us=20000)
    print("摄像头初始化完成 - 分辨率: {}x{}".format(sensor.width(), sensor.height()))

def connect_wifi():
    """连接WiFi"""
    wlan = network.WLAN(network.STA_IF)
    wlan.active(True)

    print("连接WiFi: {}...".format(SSID))

    if wlan.isconnected():
        wlan.disconnect()
        time.sleep(1)

    wlan.connect(SSID, KEY)

    timeout = 30
    while not wlan.isconnected() and timeout > 0:
        time.sleep_ms(500)
        timeout -= 1
        print(".", end="")

    if wlan.isconnected():
        print("\nWiFi连接成功!")
        print("IP地址:", wlan.ifconfig()[0])
        return True
    else:
        print("\nWiFi连接失败!")
        return False

def subscribe_topic(sock, topic):
    """订阅主题"""
    try:
        packet_id = 1
        subscribe_payload = bytearray()
        subscribe_payload.extend(struct.pack(">H", packet_id))
        subscribe_payload.extend(struct.pack(">H", len(topic)))
        subscribe_payload.extend(topic.encode())
        subscribe_payload.append(0)  # QoS 0
        
        remaining_len = len(subscribe_payload)
        subscribe_packet = bytearray([0x82, remaining_len]) + subscribe_payload
        sock.send(subscribe_packet)
        
        # 读取SUBACK响应
        suback = sock.recv(5)
        print(f"SUBACK响应: {suback.hex()}")
        print(f"✅ 成功订阅主题: {topic}")
        return True
        
    except Exception as e:
        print(f"订阅主题失败: {e}")
        return False

def connect_mqtt_socket():
    """使用原始Socket连接MQTT服务器"""
    global mqtt_socket
    
    try:
        print(f"🔗 连接MQTT Socket: {EMQX_BROKER}:{EMQX_PORT}")
        
        # 创建socket连接
        addr = socket.getaddrinfo(EMQX_BROKER, EMQX_PORT)[0][-1]
        sock = socket.socket()
        sock.connect(addr)
        print("✅ Socket连接成功")
        
        # 构建MQTT CONNECT报文
        protocol_name = "MQTT"
        protocol_level = 4
        connect_flags = 0xC2  # Clean Session, Username, Password
        keepalive = 60
        
        variable_header = bytearray()
        variable_header.extend(struct.pack(">H", len(protocol_name)))
        variable_header.extend(protocol_name.encode())
        variable_header.append(protocol_level)
        variable_header.append(connect_flags)
        variable_header.extend(struct.pack(">H", keepalive))
        
        payload = bytearray()
        payload.extend(struct.pack(">H", len(CLIENT_ID)))
        payload.extend(CLIENT_ID.encode())
        payload.extend(struct.pack(">H", len(EMQX_USERNAME)))
        payload.extend(EMQX_USERNAME.encode())
        payload.extend(struct.pack(">H", len(EMQX_PASSWORD)))
        payload.extend(EMQX_PASSWORD.encode())
        
        remaining_length = len(variable_header) + len(payload)
        fixed_header = bytearray([0x10, remaining_length])
        
        connect_packet = fixed_header + variable_header + payload
        sock.send(connect_packet)
        print("已发送CONNECT报文")
        
        # 读取CONNACK响应
        connack = sock.recv(4)
        print("CONNACK响应:", connack.hex())
        
        if connack[0] == 0x20 and connack[3] == 0x00:
            print("✅ MQTT连接成功")
            
            # 订阅识别结果主题
            subscribe_topic(sock, RECOGNITION_RESULT_TOPIC)
            
            mqtt_socket = sock
            return True
        else:
            print("❌ MQTT连接失败")
            sock.close()
            return False
            
    except Exception as e:
        print(f"❌ MQTT Socket连接失败: {e}")
        return False

def publish_message_large(topic, message):
    """发布大消息到MQTT主题 - 支持超过127字节的消息"""
    global mqtt_socket
    
    if not mqtt_socket:
        print("❌ MQTT Socket未连接")
        return False
        
    try:
        # 构建PUBLISH报文
        message_bytes = message.encode('utf-8') if isinstance(message, str) else message
        
        # 固定头部: PUBLISH (0x30), QoS 0
        fixed_header = bytearray([0x30])
        
        # 可变头部: 主题长度 + 主题
        variable_header = bytearray()
        variable_header.extend(struct.pack(">H", len(topic)))
        variable_header.extend(topic.encode())
        
        # 载荷: 消息内容
        payload = message_bytes
        
        # 计算剩余长度
        remaining_length = len(variable_header) + len(payload)
        
        # 处理大于127的剩余长度（使用多字节编码）
        if remaining_length <= 127:
            # 单字节编码
            fixed_header.append(remaining_length)
        else:
            # 多字节编码
            # 对于MQTT，剩余长度使用变长编码，每个字节最高位表示还有后续字节
            encoded_bytes = bytearray()
            while remaining_length > 0:
                encoded_byte = remaining_length % 128
                remaining_length = remaining_length // 128
                if remaining_length > 0:
                    encoded_byte = encoded_byte | 128  # 设置最高位
                encoded_bytes.append(encoded_byte)
            fixed_header.extend(encoded_bytes)
        
        # 构建完整报文
        publish_packet = fixed_header + variable_header + payload
        
        # 发送报文
        mqtt_socket.send(publish_packet)
        return True
        
    except Exception as e:
        print(f"发布消息失败: {e}")
        return False

def parse_mqtt_publish(data):
    """解析MQTT PUBLISH报文"""
    try:
        if len(data) < 4:
            return None, None
            
        # 检查是否是PUBLISH报文
        if (data[0] & 0xF0) != 0x30:
            return None, None
            
        # 解析剩余长度
        remaining_length = data[1]
        
        # 解析主题长度
        if len(data) < 4:
            return None, None
        topic_length = struct.unpack(">H", data[2:4])[0]
        
        # 检查数据长度是否足够
        if len(data) < 4 + topic_length:
            return None, None
            
        # 提取主题
        topic = data[4:4+topic_length].decode('utf-8')
        
        # 提取消息内容
        message_start = 4 + topic_length
        if len(data) < message_start:
            return topic, None
            
        message = data[message_start:]
        
        return topic, message
        
    except Exception as e:
        print(f"解析MQTT报文错误: {e}")
        return None, None

def check_and_process_messages():
    """检查并处理接收到的MQTT消息"""
    global mqtt_socket, message_buffer, received_messages, last_recognition_time
    
    if not mqtt_socket:
        return
        
    try:
        # 非阻塞接收数据
        mqtt_socket.setblocking(False)
        try:
            chunk = mqtt_socket.recv(1024)
            if chunk:
                message_buffer.extend(chunk)
        except OSError:
            # 没有数据可用，正常情况
            pass
        
        # 处理缓冲区中的数据
        while len(message_buffer) >= 2:
            packet_type = message_buffer[0] & 0xF0
            
            if packet_type == 0x30:  # PUBLISH报文
                # 对于MQTT，需要解析变长的剩余长度字段
                multiplier = 1
                remaining_length = 0
                pos = 1
                
                while True:
                    if pos >= len(message_buffer):
                        break
                    encoded_byte = message_buffer[pos]
                    remaining_length += (encoded_byte & 127) * multiplier
                    multiplier *= 128
                    pos += 1
                    if (encoded_byte & 128) == 0:
                        break
                
                total_length = pos + remaining_length
                
                # 检查是否收到完整报文
                if len(message_buffer) >= total_length:
                    # 提取完整报文
                    packet = message_buffer[:total_length]
                    message_buffer = message_buffer[total_length:]
                    
                    # 解析报文（跳过变长剩余长度字段）
                    # 重新解析，跳过固定头部
                    fixed_header_len = pos
                    if len(packet) < fixed_header_len + 2:
                        continue
                    
                    topic_length = struct.unpack(">H", packet[fixed_header_len:fixed_header_len+2])[0]
                    
                    if len(packet) < fixed_header_len + 2 + topic_length:
                        continue
                    
                    topic = packet[fixed_header_len+2:fixed_header_len+2+topic_length].decode('utf-8')
                    message = packet[fixed_header_len+2+topic_length:]
                    
                    if topic and message:
                        # 将消息添加到处理队列
                        try:
                            message_str = message.decode('utf-8')
                            received_messages.append((topic, message_str))
                            print(f"📨 收到消息 - 主题: {topic}, 长度: {len(message)}字节")
                        except Exception as e:
                            print(f"解码消息失败: {e}")
                else:
                    # 报文不完整，等待更多数据
                    break
            else:
                # 其他类型报文，跳过
                if len(message_buffer) >= 2:
                    # 同样需要解析变长剩余长度
                    multiplier = 1
                    remaining_length = 0
                    pos = 1
                    
                    while pos < len(message_buffer):
                        encoded_byte = message_buffer[pos]
                        remaining_length += (encoded_byte & 127) * multiplier
                        multiplier *= 128
                        pos += 1
                        if (encoded_byte & 128) == 0:
                            break
                    
                    total_length = pos + remaining_length
                    if len(message_buffer) >= total_length:
                        message_buffer = message_buffer[total_length:]
                    else:
                        break
                else:
                    break
                    
        # 处理接收到的消息
        process_received_messages()
        
    except Exception as e:
        print(f"检查消息时出错: {e}")

def process_received_messages():
    """处理已接收的消息"""
    global received_messages, last_recognition_time
    
    if not received_messages:
        return

    for topic, msg_str in received_messages:
        try:
            print(f"处理消息 - 主题: {topic}, 内容: {msg_str}")

            data = ujson.loads(msg_str)

            if topic == RECOGNITION_RESULT_TOPIC:
                recognized_names = data.get("recognized_names", [])
                count = data.get("count", 0)
                timestamp = data.get("timestamp", 0)
                confidence_scores = data.get("confidence_scores", [])

                if count > 0:
                    print("\n" + "="*50)
                    print("🎯 人脸识别结果:")
                    print("  识别到 {} 个人:".format(count))
                    for i, name in enumerate(recognized_names):
                        confidence_text = ""
                        if i < len(confidence_scores):
                            confidence_text = " (置信度: {}%)".format(confidence_scores[i])
                        print("  👤 {}: {}{}".format(i+1, name, confidence_text))
                    print("  时间戳:", timestamp)
                    print("="*50)

                    # 根据识别结果执行相应操作
                    for name in recognized_names:
                        print("✅ 欢迎 {}!".format(name))

                    # 发送确认消息回服务器
                    ack_message = {
                        "status": "received",
                        "recognized_names": recognized_names,
                        "count": count,
                        "client_timestamp": time.ticks_ms(),
                        "server_timestamp": timestamp
                    }
                    publish_message_large(RECOGNITION_ACK_TOPIC, ujson.dumps(ack_message))
                    print("📨 已发送确认消息到服务器")

                    last_recognition_time = time.ticks_ms()
                else:
                    print("\n❌ 未识别到任何人脸")

        except Exception as e:
            print("处理消息失败:", e)
            print("原始消息:", msg_str)

    # 清空消息队列
    received_messages = []

def send_frame():
    """发送一帧图像"""
    global frame_count

    try:
        # 捕获图像
        img = sensor.snapshot()

        # 压缩为JPEG
        jpeg_data = img.compress(quality=FRAME_QUALITY)
        if not isinstance(jpeg_data, bytes):
            jpeg_data = bytes(jpeg_data)

        frame_size = len(jpeg_data)

        # 构建消息 - 包含实际的图像数据
        message = {
            "frame_id": frame_count,
            "timestamp": time.ticks_ms(),
            "data": jpeg_data.hex()  # 恢复图像数据
        }

        # 发布消息
        if publish_message_large(VIDEO_TOPIC, ujson.dumps(message)):
            frame_count += 1

        if frame_count % 10 == 0:
            print("📹 已发送 {} 帧, 大小: {} 字节".format(frame_count, frame_size))

        return True

    except Exception as e:
        print("发送帧失败:", e)
        return False

def test_publish():
    """测试发布功能"""
    print("测试发布功能...")
    
    # 测试发送简单消息
    test_msg = {
        "test": "hello",
        "timestamp": time.ticks_ms(),
        "client_id": CLIENT_ID
    }
    
    if publish_message_large("openmv/test", ujson.dumps(test_msg)):
        print("✅ 测试消息发送成功")
        return True
    else:
        print("❌ 测试消息发送失败")
        return False

def main():
    """主函数"""
    print("=== OpenMV EMQX视频流 (Socket版 v3) ===")
    print(f"使用固定客户端ID: {CLIENT_ID}")

    # 初始化摄像头
    init_camera()

    # 连接WiFi
    if not connect_wifi():
        return

    # 连接MQTT (使用Socket)
    if not connect_mqtt_socket():
        return

    # 测试发布功能
    print("\n测试发布功能...")
    if not test_publish():
        print("❌ 发布功能测试失败，程序退出")
        return

    print("\n🚀 系统就绪! 开始视频流传输...")
    print("分辨率: {}x{}, FPS: {}, 质量: {}%".format(
        sensor.width(), sensor.height(), TARGET_FPS, FRAME_QUALITY))

    last_status_time = time.ticks_ms()
    last_message_process_time = time.ticks_ms()

    while True:
        current_time = time.ticks_ms()

        # 检查并处理MQTT消息
        check_and_process_messages()

        # 发送视频帧
        send_frame()

        # 定期发送状态
        if time.ticks_diff(current_time, last_status_time) > 10000:  # 10秒
            status_msg = {
                "frames_sent": frame_count,
                "memory_free": gc.mem_free(),
                "status": "streaming",
                "last_recognition_time": last_recognition_time,
                "current_time": current_time,
                "client_id": CLIENT_ID
            }
            try:
                if publish_message_large(STATUS_TOPIC, ujson.dumps(status_msg)):
                    # 显示状态
                    if last_recognition_time > 0 and time.ticks_diff(current_time, last_recognition_time) < 30000:
                        time_diff = time.ticks_diff(current_time, last_recognition_time) // 1000
                        print("📊 状态: {}秒前识别到人脸".format(time_diff))
                    else:
                        print("📊 状态: 运行中... 等待识别结果")
                else:
                    print("❌ 发送状态失败")

            except Exception as e:
                print("发送状态异常:", e)

            gc.collect()
            last_status_time = current_time

        # 控制帧率
        time.sleep_ms(int(1000 / TARGET_FPS))

if __name__ == "__main__":
    try:
        main()
    except Exception as e:
        print("程序错误:", e)
        import sys
        sys.print_exception(e)
    finally:
        if mqtt_socket:
            try:
                mqtt_socket.close()
                print("已关闭MQTT Socket连接")
            except:
                pass
        print("程序结束")

