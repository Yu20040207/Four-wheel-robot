STATUS_TOPIC = "openmv/status"               # 发送状态信息
RECOGNITION_RESULT_TOPIC = "openmv_recognition_result"  # 接收识别结果
RECOGNITION_ACK_TOPIC = "openmv/recognition_ack"       # 发送识别确认

# 系统状态
SYSTEM_STATE_OFF = 0
SYSTEM_STATE_READY = 1
SYSTEM_STATE_ON = 2
SYSTEM_STATE_FACE_TRACKING = 3
SYSTEM_STATE_RECOGNITION_ON = 4

