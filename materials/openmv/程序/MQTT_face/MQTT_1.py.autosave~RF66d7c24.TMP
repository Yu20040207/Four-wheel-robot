# openmv_stable_face_detection.py
# 稳定版本的人脸检测，通过串口发送数据到ESP8266
import sensor
import time
import json
from pyb import UART, LED
import gc
import machine

# ===== 硬件初始化 =====
# 摄像头初始化 - 使用稳定的参数
sensor.reset()                      # 重置相机
sensor.set_pixformat(sensor.GRAYSCALE)  # 灰度图，处理更快
sensor.set_framesize(sensor.QQVGA)  # 160x120，保证流畅性
sensor.set_windowing((120, 120))    # 进一步缩小处理区域
sensor.skip_frames(time=1000)       # 等待相机稳定

# 关闭自动调整，提高稳定性
sensor.set_auto_gain(False)
sensor.set_auto_whitebal(False)
sensor.set_auto_exposure(False)

# 串口初始化 - 连接ESP8266
uart = UART(3, 9600)  # 降低波特率提高稳定性
uart.init(9600, bits=8, parity=None, stop=1, timeout_char=1000)

# LED指示灯
red_led = LED(1)    # 错误指示
green_led = LED(2)  # 人脸检测指示
blue_led = LED(3)   # 数据发送指示

# ===== 性能配置 =====
# 人脸检测参数（经过优化的稳定参数）
DETECTION_SCALE = 1.3      # 缩放因子（较大值更快但可能漏检）
DETECTION_NEIGHBORS = 2    # 邻居数（较小值更快但可能误检）
DETECTION_THRESHOLD = 0.7  # 阈值（较高值更准确）

# 系统参数
PROCESS_INTERVAL = 500     # 处理间隔(ms)，控制检测频率
MAX_FACES = 2              # 最大处理人脸数
MIN_FACE_SIZE = 30         # 最小人脸尺寸(像素)
SEND_INTERVAL = 1000       # 发送间隔(ms)，避免频繁发送

# ===== 状态变量 =====
last_process_time = 0
last_send_time = 0
frame_count = 0
face_count = 0
system_ready = False

# ===== 稳定的人脸检测函数 =====
def stable_face_detect(img):
    """
    稳定版本的人脸检测函数
    使用优化的参数和错误处理
    """
    try:
        # 使用稳定的检测参数
        faces = img.find_features(
            sensor.HAAR_CASCADE_FACE,
            threshold=DETECTION_THRESHOLD,
            scale_factor=DETECTION_SCALE,
            min_neighbors=DETECTION_NEIGHBORS
        )
        
        # 过滤结果，只保留合理大小的人脸
        valid_faces = []
        for (x, y, w, h) in faces:
            if w >= MIN_FACE_SIZE and h >= MIN_FACE_SIZE:
                # 确保坐标在图像范围内
                x = max(0, min(x, img.width() - w))
                y = max(0, min(y, img.height() - h))
                valid_faces.append((x, y, w, h))
        
        return valid_faces
        
    except Exception as e:
        print("人脸检测错误:", e)
        return []

# ===== 稳定的数据发送函数 =====
def stable_send_data(faces):
    """
    稳定版本的数据发送函数
    包含重试机制和错误处理
    """
    global last_send_time, face_count
    
    current_time = time.ticks_ms()
    
    # 控制发送频率
    if time.ticks_diff(current_time, last_send_time) < SEND_INTERVAL:
        return False
    
    if not faces:  # 没有人脸不发送
        return False
    
    try:
        # 准备数据（简化格式提高成功率）
        data = {
            't': current_time,  # 时间戳
            'c': len(faces),    # 人脸数量
            'f': []             # 人脸列表
        }
        
        # 只发送前MAX_FACES个人脸
        for i, (x, y, w, h) in enumerate(faces[:MAX_FACES]):
            data['f'].append({
                'i': i,         # 序号
                'x': x,         # X坐标
                'y': y,         # Y坐标  
                'w': w,         # 宽度
                'h': h,         # 高度
                's': w * h      # 面积
            })
        
        # 转换为JSON
        json_str = json.dumps(data) + '\n'
        
        # 尝试发送（带重试机制）
        max_retries = 2
        for attempt in range(max_retries):
            try:
                bytes_written = uart.write(json_str)
                if bytes_written == len(json_str):
                    blue_led.on()
                    time.sleep(50)  # 短暂点亮LED
                    blue_led.off()
                    
                    face_count += len(faces)
                    last_send_time = current_time
                    
                    print("发送成功:", json_str.strip())
                    return True
                else:
                    print("发送不完整，重试...")
                    time.sleep(100)
                    
            except Exception as e:
                print("发送异常:", e)
                if attempt < max_retries - 1:
                    time.sleep(100)  # 重试前等待
        
        # 所有重试都失败
        red_led.on()
        time.sleep(200)
        red_led.off()
        return False
        
    except Exception as e:
        print("数据准备错误:", e)
        return False

# ===== 图像处理函数 =====
def process_frame():
    """
    处理单帧图像，包含性能优化
    """
    global last_process_time, frame_count
    
    current_time = time.ticks_ms()
    
    # 控制处理频率
    if time.ticks_diff(current_time, last_process_time) < PROCESS_INTERVAL:
        return None, []
    
    last_process_time = current_time
    
    try:
        # 捕获图像
        img = sensor.snapshot()
        frame_count += 1
        
        # 人脸检测
        faces = stable_face_detect(img)
        
        # 在图像上绘制结果（调试用）
        if faces:
            green_led.on()
            for (x, y, w, h) in faces:
                img.draw_rectangle(x, y, w, h, color=255, thickness=2)
            time.sleep(20)  # 短暂点亮
            green_led.off()
        
        # 显示统计信息
        if frame_count % 10 == 0:  # 每10帧显示一次
            img.draw_string(5, 5, "F:%d" % frame_count, color=255)
            if faces:
                img.draw_string(5, 15, "Faces:%d" % len(faces), color=255)
        
        return img, faces
        
    except Exception as e:
        print("帧处理错误:", e)
        return None, []

# ===== 串口命令处理 =====
def handle_uart_commands():
    """
    处理来自ESP8266的命令
    """
    if uart.any():
        try:
            command = uart.readall().decode().strip()
            if command:
                print("收到命令:", command)
                
                if command == "STATUS":
                    # 发送状态信息
                    status = {
                        'type': 'status',
                        'frames': frame_count,
                        'faces': face_count,
                        'time': time.ticks_ms()
                    }
                    uart.write(json.dumps(status) + '\n')
                    
                elif command == "RESET":
                    machine.reset()
                    
        except Exception as e:
            print("命令处理错误:", e)

# ===== 系统状态监控 =====
def system_health_check():
    """
    定期检查系统健康状况
    """
    global frame_count
    
    # 每100帧进行一次健康检查
    if frame_count % 100 == 0 and frame_count > 0:
        print("=== 系统状态 ===")
        print("总帧数:", frame_count)
        print("检测到人脸:", face_count)
        print("内存使用:", gc.mem_free())
        
        # 强制垃圾回收
        gc.collect()
        print("垃圾回收后内存:", gc.mem_free())
        print("================")

# ===== 主循环 =====
def main():
    global system_ready
    
    print("=== OpenMV稳定人脸检测系统 ===")
    print("分辨率:", sensor.width(), "x", sensor.height())
    print("格式: 灰度图")
    print("串口: UART3, 9600bps")
    
    # 启动指示灯序列
    for i in range(3):
        green_led.on()
        blue_led.on()
        time.sleep(100)
        green_led.off() 
        blue_led.off()
        time.sleep(100)
    
    system_ready = True
    print("系统就绪，开始检测...")
    
    # 性能监控
    fps_timer = time.ticks_ms()
    fps_counter = 0
    
    while True:
        try:
            # 1. 处理串口命令
            handle_uart_commands()
            
            # 2. 处理图像帧
            img, faces = process_frame()
            
            # 3. 发送检测结果
            if faces:
                stable_send_data(faces)
            
            # 4. 性能监控
            fps_counter += 1
            if time.ticks_ms() - fps_timer >= 1000:
                fps = fps_counter
                fps_counter = 0
                fps_timer = time.ticks_ms()
                
                if fps > 0:
                    print("FPS:", fps, "人脸:", face_count)
            
            # 5. 系统健康检查
            system_health_check()
            
            # 6. 短暂延时，避免过度占用CPU
            time.sleep(10)
            
        except Exception as e:
            print("主循环错误:", e)
            red_led.on()
            time.sleep(500)
            red_led.off()
            
            # 严重错误时重启
            if "memory" in str(e).lower():
                print("内存不足，尝试回收...")
                gc.collect()
                time.sleep(1000)

# ===== 启动程序 =====
if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        print("程序被用户中断")
    except Exception as e:
        print("致命错误:", e)
        print("系统重启...")
        time.sleep(2000)
        machine.reset()